{
  "name": "09090",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "pnpm lint:astro && pnpm lint:eslint && pnpm lint:style && pnpm lint:prettier",
    "lint": "pnpm check",
    "lint:astro": "astro check",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "lint:style": "stylelint \"src/**/*.css\" \"src/**/*.astro\"",
    "lint:style:fix": "stylelint --fix \"src/**/*.css\" \"src/**/*.astro\"",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint-staged": "lint-staged",
    "security:audit": "pnpm audit --audit-level=high",
    "fix": "pnpm lint:style:fix && pnpm lint:eslint:fix && pnpm lint:prettier:fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,astro}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ],
    "*.{css,astro}": [
      "stylelint --fix"
    ],
    "*.{json,yml,yaml,md,mdx,html}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not op_mini all",
    "not and_uc > 0",
    "not and_qq > 0",
    "not kaios > 0"
  ],
  "dependencies": {
    "@fontsource-variable/fira-code": "^5.2.7",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@fontsource-variable/work-sans": "^5.2.8",
    "astro": "^7.0.9",
    "sharp": "^0.35.3",
    "viem": "^2.55.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@types/node": "26.1.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.19",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "stylelint-high-performance-animation": "^2.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "stylelint-order": "^8.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.64.0"
  },
  "overrides": {
    "minimatch@<3.1.4": "3.1.4",
    "minimatch@>=9.0.0 <9.0.7": "9.0.7",
    "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
    "flatted@<3.4.0": "3.4.0",
    "css-tree@<3.2.1": "3.2.1"
  }
}
