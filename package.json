{
  "name": "yhay81-profile",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-integrity.mjs && node scripts/verify-release.mjs --artifact-dir dist",
    "build:ipfs-capsule": "node scripts/build-ipfs-capsule.mjs",
    "deploy:cloudflare": "wrangler deploy --env=\"\"",
    "preview": "astro preview",
    "check": "pnpm typecheck && pnpm lint:astro && pnpm lint:eslint && pnpm lint:style && pnpm lint:prettier",
    "lint": "pnpm check",
    "typecheck": "tsc --noEmit",
    "lint:astro": "astro check",
    "lint:eslint": "eslint . --max-warnings 0",
    "lint:eslint:fix": "eslint . --fix --max-warnings 0",
    "lint:style": "stylelint \"src/**/*.css\" \"src/**/*.astro\"",
    "lint:style:fix": "stylelint --fix \"src/**/*.css\" \"src/**/*.astro\"",
    "lint:prettier": "prettier --check .",
    "lint:prettier:fix": "prettier --write .",
    "lint-staged": "lint-staged",
    "security:audit": "pnpm audit --audit-level=moderate",
    "security:signatures": "pnpm audit signatures",
    "security:check": "pnpm security:audit && pnpm security:signatures",
    "sync:writing": "node scripts/sync-writing.mjs",
    "verify:links": "node scripts/check-links.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "fix": "pnpm lint:style:fix && pnpm lint:eslint:fix && pnpm lint:prettier:fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,astro}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored"
    ],
    "*.{css,astro}": [
      "stylelint --fix"
    ],
    "*.{json,yml,yaml,md,mdx,html}": [
      "prettier --write"
    ]
  },
  "browserslist": [
    "defaults",
    "not IE 11",
    "not op_mini all",
    "not and_uc > 0",
    "not and_qq > 0",
    "not kaios > 0"
  ],
  "dependencies": {
    "astro": "^7.4.7",
    "openpgp": "6.3.2",
    "sharp": "^0.35.5",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y-x": "^0.2.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.32",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "stylelint-high-performance-animation": "^2.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "stylelint-order": "^8.1.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.158.0"
  }
}
