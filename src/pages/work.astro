---
import { WORK_CATALOG, WORK_CATALOG_COUNT } from "@/data/work-catalog";
import Base from "@/layouts/Base.astro";

const FEATURED_PROJECTS = [
  {
    id: "wasmhatch",
    index: "01",
    name: "WasmHatch",
    field: "Browser-native AI",
  },
  {
    id: "pylopdf",
    index: "02",
    name: "pylopdf",
    field: "Python + Rust",
  },
  {
    id: "hayate",
    index: "03",
    name: "hayate",
    field: "Web standards",
  },
  {
    id: "public-data-catalog",
    index: "04",
    name: "Public Data Catalog",
    field: "Verifiable data",
  },
  {
    id: "socialname",
    index: "05",
    name: "SocialName",
    field: "Identity observability",
  },
  {
    id: "yomiage-kun",
    index: "06",
    name: "Yomiage-kun",
    field: "Local-first desktop",
  },
] as const;
---

<Base
  description="Selected products and open-source systems by Yusuke Hayashi across browser-native AI, Python and Rust tooling, web standards, and verifiable public data."
  path="/work"
  title="Selected Work | Yusuke Hayashi"
>
  <main class="workMain">
    <section aria-labelledby="work-title" class="workHero">
      <div class="heroCopy">
        <p class="eyebrow"><span>00</span> Products &amp; open source</p>
        <h1 data-view-transition-name="page-title" id="work-title">
          Selected<br />Work
        </h1>
        <p class="heroSummary">
          I build products and open-source systems that make complex
          capabilities usable, verifiable, and portable.
        </p>
      </div>

      <nav aria-label="Featured projects" class="projectIndex">
        <ol>
          {
            FEATURED_PROJECTS.map((project) => (
              <li>
                <a href={`#${project.id}`}>
                  <span class="indexNo">{project.index}</span>
                  <span class="indexName">{project.name}</span>
                  <span class="indexField">{project.field}</span>
                  <span aria-hidden="true" class="indexArrow">
                    ↘
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </section>

    <div class="featuredWork">
      <article class="project reveal" id="wasmhatch">
        <div class="projectCopy">
          <p class="projectLabel">
            <span>01</span>
            Browser-native AI
          </p>
          <h2>WasmHatch</h2>
          <p class="projectRole">Lead builder · Haya Inc. · Open source</p>
          <p class="projectSummary">
            An AI assistant that does the work directly in Google Docs, Sheets,
            and Slides — without a server, install, or account.
          </p>
          <p class="projectDetail">
            The product runs in the browser, supports user-supplied models and
            Chrome AI, and keeps every proposed change visible and undoable.
          </p>
          <ul aria-label="WasmHatch technologies" class="tags">
            <li>WebAssembly</li>
            <li>Browser AI</li>
            <li>Office workflows</li>
          </ul>
          <div class="projectLinks">
            <a href="https://wasmhatch.com/?view=chat">Open product ↗</a>
            <a href="https://github.com/haya-inc/wasmhatch">Source ↗</a>
          </div>
        </div>

        <a
          aria-label="Open WasmHatch"
          class="productCanvas wasmhatchCanvas"
          href="https://wasmhatch.com/?view=chat"
        >
          <span class="canvasTopbar">
            <span class="wasmMark">W</span>
            <span>WasmHatch</span>
            <span class="canvasStatus">Local session</span>
          </span>
          <span class="wasmStage">
            <span class="wasmHeadline">
              The assistant<br />
              that <strong>does</strong> the work.
            </span>
            <span class="wasmChat">
              <span class="chatLabel">YOU</span>
              <span class="chatRequest">
                Turn this outline into a finished launch brief.
              </span>
              <span class="chatAction">
                <span aria-hidden="true">✓</span>
                6 visible edits ready to review
              </span>
            </span>
          </span>
        </a>
      </article>

      <article class="project reveal" id="pylopdf">
        <div class="projectCopy">
          <p class="projectLabel"><span>02</span> Python + Rust</p>
          <h2>pylopdf</h2>
          <p class="projectRole">Creator and maintainer · MIT</p>
          <p class="projectSummary">
            A compact Python API for editing, rendering, extracting, and
            generating PDFs, backed by a Rust core.
          </p>
          <p class="projectDetail">
            It combines Python ergonomics with small wheels and no mandatory
            Python dependencies, providing a permissive alternative for
            production PDF workflows.
          </p>
          <ul aria-label="pylopdf technologies" class="tags">
            <li>Python</li>
            <li>Rust</li>
            <li>PDF</li>
          </ul>
          <div class="projectLinks">
            <a href="https://yhay81.github.io/pylopdf/">Read the docs ↗</a>
            <a href="https://pypi.org/project/pylopdf/">PyPI ↗</a>
            <a href="https://github.com/yhay81/pylopdf">Source ↗</a>
          </div>
        </div>

        <a
          aria-label="Read the pylopdf documentation"
          class="productCanvas pylopdfCanvas"
          href="https://yhay81.github.io/pylopdf/"
        >
          <span class="pylopdfNav">
            <span class="pyLogo">py<span>lo</span>pdf</span>
            <span>Docs</span>
            <span>API</span>
            <span>GitHub ↗</span>
          </span>
          <span class="pylopdfStage">
            <span class="pylopdfHeadline">
              PDFs, with Python<br />
              ergonomics and a<br />
              <em>Rust core.</em>
            </span>
            <span class="pdfDocument">
              <span class="pdfFold"></span>
              <span class="pdfTitle">PDF</span>
              <span class="pdfLines"></span>
              <span class="pdfLines short"></span>
              <span class="pdfCode">doc.save("output.pdf")</span>
            </span>
          </span>
        </a>
      </article>

      <article class="project reveal" id="hayate">
        <div class="projectCopy">
          <p class="projectLabel"><span>03</span> Web standards</p>
          <h2>hayate</h2>
          <p class="projectRole">Creator and maintainer · MIT</p>
          <p class="projectSummary">
            A standards-first Python web framework built around WHATWG Fetch,
            URL, and URLPattern.
          </p>
          <p class="projectDetail">
            The same application model moves across ASGI, Cloudflare Workers,
            and AWS Lambda instead of making deployment targets define the
            programming model.
          </p>
          <ul aria-label="hayate technologies" class="tags">
            <li>Python</li>
            <li>WHATWG Fetch</li>
            <li>Edge runtimes</li>
          </ul>
          <div class="projectLinks">
            <a href="https://hayatepy.github.io/hayate/">Read the docs ↗</a>
            <a href="https://pypi.org/project/hayate/">PyPI ↗</a>
            <a href="https://github.com/hayatepy/hayate">Source ↗</a>
          </div>
        </div>

        <a
          aria-label="Read the hayate documentation"
          class="productCanvas hayateCanvas"
          href="https://hayatepy.github.io/hayate/"
        >
          <span class="hayateBar">
            <span class="hayateBrand">hayate</span>
            <span>Documentation</span>
            <span class="hayateSearch">Search docs&nbsp; ⌘K</span>
          </span>
          <span class="hayateStage">
            <span class="docsNav">
              <strong>Getting started</strong>
              <span>Installation</span>
              <span>Quick start</span>
              <span>Routing</span>
              <strong>Deploy</strong>
              <span>ASGI</span>
              <span>Workers</span>
            </span>
            <span class="docsContent">
              <span class="docsOverline">QUICK START</span>
              <span class="docsTitle"
                >Web standards,<br />native to Python.</span
              >
              <span class="docsText"> One request model. Every runtime. </span>
              <span class="codePanel">
                <span><i>from</i> hayate <i>import</i> Hayate</span>
                <span>&nbsp;</span>
                <span>app = Hayate()</span>
                <span><b>@app.get</b>(<q>"/hello"</q>)</span>
              </span>
            </span>
          </span>
        </a>
      </article>

      <article class="project reveal" id="public-data-catalog">
        <div class="projectCopy">
          <p class="projectLabel"><span>04</span> Verifiable data</p>
          <h2>Public Data Catalog</h2>
          <p class="projectRole">Creator and maintainer · Open source</p>
          <p class="projectSummary">
            A Japanese-first catalog of tested public-data retrieval recipes
            designed for people and AI agents.
          </p>
          <p class="projectDetail">
            Each recipe carries provenance, licensing, freshness, and an
            executable path so agents can do more than point at a dataset.
          </p>
          <ul aria-label="Public Data Catalog technologies" class="tags">
            <li>MCP</li>
            <li>Open data</li>
            <li>Provenance</li>
          </ul>
          <div class="projectLinks">
            <a href="https://public-data-catalog-mcp.yusuke8h.workers.dev/">
              Open catalog ↗
            </a>
            <a href="https://github.com/yhay81/public-data-catalog">
              Source ↗
            </a>
          </div>
        </div>

        <a
          aria-label="Open Public Data Catalog"
          class="productCanvas catalogCanvas"
          href="https://public-data-catalog-mcp.yusuke8h.workers.dev/"
        >
          <span class="catalogBar">
            <span class="catalogMark">公</span>
            <span>Public Data Catalog</span>
            <span class="catalogOnline">● MCP online</span>
          </span>
          <span class="catalogStage">
            <span class="catalogHeadline">
              公的データを、<br /><strong>AIで使う。</strong>
            </span>
            <span class="catalogCopy">
              出典・ライセンス・鮮度を保ったまま、取得から検証まで。
            </span>
            <span class="catalogConnection">
              <small>CONNECTION URL</small>
              <span>…workers.dev/mcp</span>
              <b>Copy</b>
            </span>
            <span class="catalogStats">
              <span><b>Tested</b> recipes</span>
              <span><b>Live</b> verification</span>
              <span><b>Open</b> provenance</span>
            </span>
          </span>
        </a>
      </article>

      <article class="project reveal" id="socialname">
        <div class="projectCopy">
          <p class="projectLabel"><span>05</span> Identity observability</p>
          <h2>SocialName</h2>
          <p class="projectRole">Creator and maintainer · Active development</p>
          <p class="projectSummary">
            A local-first platform that turns public-identifier presence and
            change into evidence-backed observations.
          </p>
          <p class="projectDetail">
            One Rust engine powers CLI, desktop, API, and managed monitoring
            while signed rules, deterministic classification, and explicit
            consent prevent a matching username from becoming a false identity
            claim.
          </p>
          <ul aria-label="SocialName technologies" class="tags">
            <li>Rust</li>
            <li>Tauri</li>
            <li>Evidence</li>
          </ul>
          <div class="projectLinks">
            <a href="https://github.com/yhay81/socialname">Source ↗</a>
          </div>
        </div>

        <a
          aria-label="Open the SocialName source repository"
          class="productCanvas socialNameCanvas"
          href="https://github.com/yhay81/socialname"
        >
          <span class="identityBar">
            <span class="identityMark">S</span>
            <span>SocialName</span>
            <span class="identityPrivacy">Local research</span>
          </span>
          <span class="identityStage">
            <span class="identityKicker">PUBLIC IDENTIFIER OBSERVABILITY</span>
            <span class="identityHeadline">
              A match is a signal.<br />
              <strong>Evidence makes it useful.</strong>
            </span>
            <span class="probePanel">
              <span class="probeRow">
                <span class="probeSite">github</span>
                <span class="probeTrace">200 · profile markers</span>
                <b class="probeFound">found</b>
              </span>
              <span class="probeRow">
                <span class="probeSite">npm</span>
                <span class="probeTrace">404 · absence marker</span>
                <b class="probeAbsent">not found</b>
              </span>
              <span class="probeRow">
                <span class="probeSite">nostr</span>
                <span class="probeTrace">redirect conflict</span>
                <b class="probeReview">review</b>
              </span>
            </span>
            <span class="identityFoot">
              deterministic result · evidence digest · user-owned cache
            </span>
          </span>
        </a>
      </article>

      <article class="project reveal" id="yomiage-kun">
        <div class="projectCopy">
          <p class="projectLabel"><span>06</span> Local-first desktop</p>
          <h2>Yomiage-kun</h2>
          <p class="projectRole">Creator and maintainer · Windows + macOS</p>
          <p class="projectSummary">
            A desktop app that reads Discord text channels into voice using
            local Japanese speech engines.
          </p>
          <p class="projectDetail">
            Users bring their own Discord bot, credentials stay in the operating
            system keychain, and generated audio moves from AivisSpeech or
            VOICEVOX to Discord without a hosted intermediary.
          </p>
          <ul aria-label="Yomiage-kun technologies" class="tags">
            <li>Rust</li>
            <li>Tauri 2</li>
            <li>Discord Voice</li>
          </ul>
          <div class="projectLinks">
            <a href="https://github.com/yhay81/yomiage-kun/releases">
              Download ↗
            </a>
            <a href="https://github.com/yhay81/yomiage-kun">Source ↗</a>
          </div>
        </div>

        <a
          aria-label="Download Yomiage-kun"
          class="productCanvas yomiageCanvas"
          href="https://github.com/yhay81/yomiage-kun/releases"
        >
          <span class="yomiageBar">
            <span aria-hidden="true" class="windowControls">
              <i class="windowDot"></i><i class="windowDot"></i><i
                class="windowDot"></i>
            </span>
            <span>Yomiage-kun</span>
            <span class="yomiageLocal">● Local voice</span>
          </span>
          <span class="yomiageStage">
            <span class="voiceIntro">
              <span class="voiceKicker">DISCORD × LOCAL TTS</span>
              <span class="voiceTitle">Chat becomes<br />a shared voice.</span>
              <span class="voiceEngine">AivisSpeech / VOICEVOX</span>
            </span>
            <span class="voicePlayer">
              <span class="voiceChannel">
                <span class="voiceAvatar">Y</span>
                <span>
                  <small>CONNECTED TO</small>
                  <b>General / Voice</b>
                </span>
                <i class="voiceLive">LIVE</i>
              </span>
              <span aria-hidden="true" class="waveform">
                <i class="waveBar"></i><i class="waveBar"></i><i class="waveBar"
                ></i><i class="waveBar"></i><i class="waveBar"></i><i
                  class="waveBar"></i><i class="waveBar"></i><i class="waveBar"
                ></i><i class="waveBar"></i><i class="waveBar"></i><i
                  class="waveBar"></i><i class="waveBar"></i>
              </span>
              <span class="voiceMessage">
                <small>READING NOW</small>
                リリースの準備ができました。
              </span>
            </span>
          </span>
        </a>
      </article>
    </div>

    <section aria-labelledby="work-catalog-title" class="workCatalog reveal">
      <header class="catalogHeader">
        <div>
          <p class="eyebrow">
            <span>{WORK_CATALOG_COUNT}</span> Complete index
          </p>
          <h2 id="work-catalog-title">The work keeps growing.</h2>
        </div>
        <p class="catalogIntroduction">
          Featured projects stay spacious above. The complete public record
          below is organized into expandable collections, so new products,
          repositories, and earlier work can be added without turning the page
          into an endless wall.
        </p>
      </header>

      <nav aria-label="Work collections" class="catalogNavigation">
        <ol>
          {
            WORK_CATALOG.map((group, groupIndex) => (
              <li>
                <a href={`#catalog-${group.id}`}>
                  <span>{String(groupIndex + 1).padStart(2, "0")}</span>
                  <b>{group.label}</b>
                  <small>{group.items.length} works</small>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="catalogGroups">
        {
          WORK_CATALOG.map((group, groupIndex) => (
            <details
              class="catalogGroup"
              id={`catalog-${group.id}`}
              name="work-catalog"
              open={group.open}
            >
              <summary>
                <span class="catalogGroupIndex">
                  {String(groupIndex + 1).padStart(2, "0")}
                </span>
                <span class="catalogGroupHeading">
                  <small>{group.label}</small>
                  <b>{group.title}</b>
                </span>
                <span class="catalogGroupDescription">{group.description}</span>
                <span class="catalogGroupCount">
                  {String(group.items.length).padStart(2, "0")}
                </span>
                <i aria-hidden="true" class="catalogGroupToggle" />
              </summary>

              <div class="catalogItems">
                {group.items.map((item, itemIndex) => (
                  <article
                    class:list={["catalogItem", { catalogItemLead: item.lead }]}
                    id={item.id}
                  >
                    <div class="catalogItemHeading">
                      <p class="catalogItemMeta">
                        {String(groupIndex + 1).padStart(2, "0")}.
                        {String(itemIndex + 1).padStart(2, "0")}
                        <span>·</span>
                        {item.field}
                      </p>
                      <h3>{item.name}</h3>
                    </div>
                    <p class="catalogItemDescription">{item.description}</p>
                    <p class="catalogItemSignal">{item.signal}</p>
                    <div class="catalogItemLinks">
                      {item.links.map((link) => (
                        <a href={link.href}>{link.label} ↗</a>
                      ))}
                    </div>
                  </article>
                ))}
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="work-contact-title" class="workContact reveal">
      <p class="eyebrow"><span>Next</span> Build with me</p>
      <h2 id="work-contact-title">
        Have a difficult workflow that should become a useful product?
      </h2>
      <div class="contactLinks">
        <a class="contactPrimary" href="/#contact">Start a conversation</a>
        <a href="https://github.com/yhay81">See all repositories ↗</a>
      </div>
    </section>
  </main>
</Base>

<style>
  .workMain {
    max-width: 1600px;
    padding-top: var(--nav-height);
  }

  .workHero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
    gap: clamp(48px, 7vw, 88px);
    align-items: center;
    max-width: 1000px;
    min-height: calc(100svh - var(--nav-height));
    padding-top: clamp(72px, 11vh, 120px);
    padding-bottom: clamp(72px, 11vh, 120px);
  }

  .eyebrow,
  .projectLabel {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-soft);
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .eyebrow {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  .eyebrow span {
    color: var(--color-accent);
  }

  .heroCopy h1 {
    margin: 20px 0 28px;
    font-size: clamp(3rem, 7vw, 4.8rem);
    font-weight: 600;
    line-height: 0.94;
    letter-spacing: -0.04em;
    text-shadow: 0 10px 30px var(--accent-glow);
  }

  .heroSummary {
    max-width: 520px;
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-soft);
  }

  .projectIndex ol {
    padding: 0;
    margin: 0;
    list-style: none;
    border-top: 1px solid var(--border-strong);
  }

  .projectIndex li {
    border-bottom: 1px solid var(--border-strong);
  }

  .projectIndex a {
    display: grid;
    grid-template-columns: 32px 1fr auto 24px;
    gap: 16px;
    align-items: center;
    padding: 21px 0;
    color: var(--color-text-strong);
  }

  .indexNo,
  .indexField {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text);
  }

  .indexField {
    text-align: right;
  }

  .indexName {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .indexArrow {
    color: var(--color-accent);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .projectIndex a:hover .indexArrow,
  .projectIndex a:focus-visible .indexArrow {
    transform: translate(3px, 3px);
  }

  .featuredWork {
    max-width: 1000px;
    margin: 0 auto;
    border-top: 1px solid var(--border-strong);
  }

  .project {
    display: grid;
    grid-template-columns: minmax(280px, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(48px, 6vw, 76px);
    align-items: center;
    min-height: min(78vh, 780px);
    padding: clamp(80px, 10vh, 112px) 0;
    scroll-margin-top: calc(var(--nav-height) + 24px);
    border-bottom: 1px solid var(--border-strong);
  }

  .projectCopy {
    max-width: 470px;
  }

  .project:nth-child(even) {
    grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.7fr);
  }

  .project:nth-child(even) .projectCopy {
    order: 2;
  }

  .projectLabel {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .projectLabel span {
    color: var(--color-accent);
  }

  .project h2 {
    margin: 20px 0 12px;
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    letter-spacing: -0.04em;
  }

  .projectRole {
    margin: 0 0 28px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text);
  }

  .projectSummary {
    margin: 0 0 18px;
    font-size: var(--text-lg);
    line-height: 1.42;
    color: var(--color-text-strong);
  }

  .projectDetail {
    margin: 0;
    color: var(--color-text-soft);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 28px 0 0;
    list-style: none;
  }

  .tags li {
    padding: 5px 10px;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-soft);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
  }

  .projectLinks,
  .contactLinks {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 24px;
    align-items: center;
    margin-top: 32px;
  }

  .projectLinks a,
  .catalogItemLinks a,
  .contactLinks a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--color-text-strong);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 6px;
  }

  .projectLinks a:hover,
  .projectLinks a:focus-visible,
  .catalogItemLinks a:hover,
  .catalogItemLinks a:focus-visible,
  .contactLinks a:hover,
  .contactLinks a:focus-visible {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .productCanvas {
    display: block;
    min-width: 0;
    min-height: 420px;
    overflow: hidden;
    color: var(--color-bg-deep);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition:
      border-color var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
  }

  .productCanvas:hover,
  .productCanvas:focus-visible {
