---
import { WORK_CATALOG, WORK_CATALOG_COUNT } from "@/data/work-catalog";
import Base from "@/layouts/Base.astro";

const FEATURED_PROJECTS = [
  {
    id: "wasmhatch",
    index: "01",
    name: "WasmHatch",
    field: "Browser-native AI",
  },
  {
    id: "pylopdf",
    index: "02",
    name: "pylopdf",
    field: "Python + Rust",
  },
  {
    id: "hayate",
    index: "03",
    name: "hayate",
    field: "Web standards",
  },
  {
    id: "prooflock",
    index: "04",
    name: "ProofLock",
    field: "PR verification integrity",
  },
] as const;

const WORK_MARKS: Readonly<Record<string, string>> = {
  "prooflock-index": "PL",
  deban: "DE",
  "civic-contribution-catalog": "CC",
  "ai-partners": "AP",
  "ai-demand": "AD",
  "haya-inc": "HI",
  "wiki-shindanshi": "診",
  "wasmhatch-index": "WH",
  hayasend: "HS",
  clawsembly: "CL",
  "clawsembly-kernel": "CK",
  "engineering-bootcamp": "EB",
  "wiki-kit": "WK",
  "create-wiki-kit": "CW",
  "knowledge-kit": "KK",
  "create-knowledge-kit": "C·K",
  "discovery-kit": "DK",
  "create-discovery-kit": "CD",
  "hayate-index": "HY",
  "hayate-auth": "HA",
  "hayate-mcp": "HM",
  "hayate-openapi": "HO",
  "hayate-fetch": "HF",
  "create-hayate": "CH",
  firsthand: "FH",
  "public-data-catalog-index": "PD",
  socialname: "SN",
  "pylopdf-index": "PY",
  foliomcp: "FM",
  "gh-freshclone": "GF",
  "ja-translation-todo": "JT",
  gaslacker: "GA",
  "code-sortings": "CS",
  "yomiage-kun": "YK",
  "profile-site": "YH",
  "github-issues-wasm": "GI",
  "pythonic-peano-arithmetic": "PP",
  "frontend-handbook-ja": "FE",
  sesforwader: "SF",
};

function workMark(id: string, name: string) {
  const explicitMark = WORK_MARKS[id];
  if (explicitMark) return explicitMark;

  const words = name
    .replace(/([a-z\d])([A-Z])/g, "$1 $2")
    .split(/[^A-Za-z0-9]+/)
    .filter(Boolean);

  if (words.length > 1) {
    return `${words[0][0]}${words[1][0]}`.toUpperCase();
  }

  return (words[0] ?? name).slice(0, 2).toUpperCase();
}
---

<Base
  description="Selected products and open-source systems by Yusuke Hayashi across browser-native AI, Python and Rust tooling, web standards, and verifiable public data."
  path="/work"
  title="Selected Work | Yusuke Hayashi"
>
  <main class="workMain">
    <section aria-labelledby="work-title" class="workHero">
      <div class="heroCopy">
        <p class="eyebrow"><span>00</span> Products &amp; open source</p>
        <h1 data-view-transition-name="page-title" id="work-title">
          Selected<br />Work
        </h1>
        <p class="heroSummary">
          I build products and open-source systems that make complex
          capabilities usable, verifiable, and portable.
        </p>
      </div>

      <nav aria-label="Featured projects" class="projectIndex">
        <ol>
          {
            FEATURED_PROJECTS.map((project) => (
              <li>
                <a href={`#${project.id}`}>
                  <span class="indexNo">{project.index}</span>
                  <span class="indexName">{project.name}</span>
                  <span class="indexField">{project.field}</span>
                  <span aria-hidden="true" class="indexArrow">
                    ↘
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </section>

    <div class="featuredWork">
      <article class="project reveal" id="wasmhatch">
        <div class="projectCopy">
          <p class="projectLabel">
            <span>01</span>
            Browser-native AI
          </p>
          <h2>WasmHatch</h2>
          <p class="projectRole">Lead builder · Haya Inc. · Open source</p>
          <p class="projectSummary">
            An AI assistant that does the work directly in Google Docs, Sheets,
            and Slides — without a server, install, or account.
          </p>
          <p class="projectDetail">
            The product runs in the browser, supports user-supplied models and
            Chrome AI, and keeps every proposed change visible and undoable.
          </p>
          <ul aria-label="WasmHatch technologies" class="tags">
            <li>WebAssembly</li>
            <li>Browser AI</li>
            <li>Office workflows</li>
          </ul>
          <div class="projectLinks">
            <a href="https://wasmhatch.com/?view=chat">Open product ↗</a>
            <a href="https://github.com/haya-inc/wasmhatch">Source ↗</a>
          </div>
        </div>

        <a
          aria-label="Open WasmHatch"
          class="productCanvas wasmhatchCanvas"
          href="https://wasmhatch.com/?view=chat"
        >
          <span class="canvasTopbar">
            <span class="wasmMark">W</span>
            <span>WasmHatch</span>
            <span class="canvasStatus">Local session</span>
          </span>
          <span class="wasmStage">
            <span class="wasmHeadline">
              The assistant<br />
              that <strong>does</strong> the work.
            </span>
            <span class="wasmChat">
              <span class="chatLabel">YOU</span>
              <span class="chatRequest">
                Turn this outline into a finished launch brief.
              </span>
              <span class="chatAction">
                <span aria-hidden="true">✓</span>
                6 visible edits ready to review
              </span>
            </span>
          </span>
        </a>
      </article>

      <article class="project reveal" id="pylopdf">
        <div class="projectCopy">
          <p class="projectLabel"><span>02</span> Python + Rust</p>
          <h2>pylopdf</h2>
          <p class="projectRole">Creator and maintainer · MIT</p>
          <p class="projectSummary">
            A compact Python API for editing, rendering, extracting, and
            generating PDFs, backed by a Rust core.
          </p>
          <p class="projectDetail">
            It combines Python ergonomics with small wheels and no mandatory
            Python dependencies, providing a permissive alternative for
            production PDF workflows.
          </p>
          <ul aria-label="pylopdf technologies" class="tags">
            <li>Python</li>
            <li>Rust</li>
            <li>PDF</li>
          </ul>
          <div class="projectLinks">
            <a href="https://yhay81.github.io/pylopdf/">Read the docs ↗</a>
            <a href="https://pypi.org/project/pylopdf/">PyPI ↗</a>
            <a href="https://github.com/yhay81/pylopdf">Source ↗</a>
          </div>
        </div>

        <a
          aria-label="Read the pylopdf documentation"
          class="productCanvas pylopdfCanvas"
          href="https://yhay81.github.io/pylopdf/"
        >
          <span class="pylopdfNav">
            <span class="pyLogo">py<span>lo</span>pdf</span>
            <span>Docs</span>
            <span>API</span>
            <span>GitHub ↗</span>
          </span>
          <span class="pylopdfStage">
            <span class="pylopdfHeadline">
              PDFs, with Python<br />
              ergonomics and a<br />
              <em>Rust core.</em>
            </span>
            <span class="pdfDocument">
              <span class="pdfFold"></span>
              <span class="pdfTitle">PDF</span>
              <span class="pdfLines"></span>
              <span class="pdfLines short"></span>
              <span class="pdfCode">doc.save("output.pdf")</span>
            </span>
          </span>
        </a>
      </article>

      <article class="project reveal" id="hayate">
        <div class="projectCopy">
          <p class="projectLabel"><span>03</span> Web standards</p>
          <h2>hayate</h2>
          <p class="projectRole">Creator and maintainer · MIT</p>
          <p class="projectSummary">
            A standards-first Python web framework built around WHATWG Fetch,
            URL, and URLPattern.
          </p>
          <p class="projectDetail">
            The same application model moves across ASGI, Cloudflare Workers,
            and AWS Lambda instead of making deployment targets define the
            programming model.
          </p>
          <ul aria-label="hayate technologies" class="tags">
            <li>Python</li>
            <li>WHATWG Fetch</li>
            <li>Edge runtimes</li>
          </ul>
          <div class="projectLinks">
            <a href="https://hayatepy.github.io/hayate/">Read the docs ↗</a>
            <a href="https://pypi.org/project/hayate/">PyPI ↗</a>
            <a href="https://github.com/hayatepy/hayate">Source ↗</a>
          </div>
        </div>

        <a
          aria-label="Read the hayate documentation"
          class="productCanvas hayateCanvas"
          href="https://hayatepy.github.io/hayate/"
        >
          <span class="hayateBar">
            <span class="hayateBrand">hayate</span>
            <span>Documentation</span>
            <span class="hayateSearch">Search docs&nbsp; ⌘K</span>
          </span>
          <span class="hayateStage">
            <span class="docsNav">
              <strong>Getting started</strong>
              <span>Installation</span>
              <span>Quick start</span>
              <span>Routing</span>
              <strong>Deploy</strong>
              <span>ASGI</span>
              <span>Workers</span>
            </span>
            <span class="docsContent">
              <span class="docsOverline">QUICK START</span>
              <span class="docsTitle"
                >Web standards,<br />native to Python.</span
              >
              <span class="docsText"> One request model. Every runtime. </span>
              <span class="codePanel">
                <span><i>from</i> hayate <i>import</i> Hayate</span>
                <span>&nbsp;</span>
                <span>app = Hayate()</span>
                <span><b>@app.get</b>(<q>"/hello"</q>)</span>
              </span>
            </span>
          </span>
        </a>
      </article>

      <article class="project reveal" id="prooflock">
        <div class="projectCopy">
          <p class="projectLabel"><span>04</span> PR verification integrity</p>
          <h2>ProofLock</h2>
          <p class="projectRole">Lead builder · Haya Inc. · Live GitHub App</p>
          <p class="projectSummary">
            A GitHub App that protects the checks used to prove a pull request
            is safe.
          </p>
          <p class="projectDetail">
            It evaluates tests, workflows, policy, and other protected surfaces
            against the base commit, then fails closed when the evidence is
            incomplete or a pull request attempts to weaken its own guardrails.
          </p>
          <ul aria-label="ProofLock technologies" class="tags">
            <li>GitHub App</li>
            <li>Cloudflare</li>
            <li>Policy engine</li>
          </ul>
          <div class="projectLinks">
            <a href="https://prooflock.yusuke-hayashi.com/">Open product ↗</a>
            <a href="https://prooflock.yusuke-hayashi.com/status/v1.json">
              Live status ↗
            </a>
          </div>
        </div>

        <a
          aria-label="Open ProofLock"
          class="productCanvas proofLockCanvas"
          href="https://prooflock.yusuke-hayashi.com/"
        >
          <span class="proofBar">
            <span class="proofMark">P</span>
            <span>ProofLock</span>
            <span class="proofStatus">GitHub App · Live</span>
          </span>
          <span class="proofStage">
            <span class="proofKicker">PR VERIFICATION INTEGRITY</span>
            <span class="proofHeadline">
              Protect the proof,<br />
              <strong>before merge.</strong>
            </span>
            <span class="proofPanel">
              <span class="proofRow">
                <span class="proofSurface">production code</span>
                <span class="proofTrace">14 files changed</span>
                <b class="proofPass">observed</b>
              </span>
              <span class="proofRow">
                <span class="proofSurface">protected surfaces</span>
                <span class="proofTrace">workflow + tests</span>
                <b class="proofGuard">changed</b>
              </span>
              <span class="proofRow">
                <span class="proofSurface">decision</span>
                <span class="proofTrace">base policy · current head</span>
                <b class="proofGuard">approval required</b>
              </span>
            </span>
            <span class="proofFoot">
              base-SHA policy · deterministic rules · fail closed
            </span>
          </span>
        </a>
      </article>
    </div>

    <section aria-labelledby="work-catalog-title" class="workCatalog reveal">
      <header class="catalogHeader">
        <div>
          <p class="eyebrow">
            <span>{WORK_CATALOG_COUNT}</span> Complete index
          </p>
          <h2 id="work-catalog-title">The work keeps growing.</h2>
        </div>
        <p class="catalogIntroduction">
          Five visible collections hold the complete public record. Open any
          collection to scan its products, systems, and experiments.
        </p>
      </header>

      <div class="catalogGroups" data-work-catalog>
        {
          WORK_CATALOG.map((group, groupIndex) => (
            <details
              class="catalogGroup"
              id={`catalog-${group.id}`}
              name="work-catalog"
            >
              <summary>
                <span class="catalogGroupIndex">
                  {String(groupIndex + 1).padStart(2, "0")}
                </span>
                <span class="catalogGroupHeading">
                  <small>{group.label}</small>
                  <b>{group.title}</b>
                </span>
                <span class="catalogGroupDescription">{group.description}</span>
                <span class="catalogGroupAction">
                  <small class="catalogGroupClosed">
                    View {String(group.items.length).padStart(2, "0")} works
                  </small>
                  <small class="catalogGroupOpened">Close collection</small>
                </span>
                <i aria-hidden="true" class="catalogGroupToggle" />
              </summary>

              <div class="catalogItems">
                {group.items.map((item, itemIndex) => (
                  <article
                    class:list={["catalogItem", { catalogItemLead: item.lead }]}
                    id={item.id}
                  >
                    <div
                      aria-hidden="true"
                      class="catalogItemVisual"
                      data-family={String(groupIndex + 1)}
                      style={`--visual-x: ${
                        18 + ((itemIndex * 17 + groupIndex * 11) % 64)
                      }%; --visual-y: ${
                        24 + ((itemIndex * 13 + groupIndex * 7) % 52)
                      }%;`}
                    >
                      <span class="catalogVisualChrome">
                        <i />
                        <i />
                        <i />
                        <b>
                          {String(groupIndex + 1).padStart(2, "0")}—
                          {String(itemIndex + 1).padStart(2, "0")}
                        </b>
                      </span>
                      <strong>{workMark(item.id, item.name)}</strong>
                      <span class="catalogVisualTrace">
                        <i />
                        <b />
                      </span>
                    </div>
                    <div class="catalogItemHeading">
                      <p class="catalogItemMeta">
                        {String(groupIndex + 1).padStart(2, "0")}.
                        {String(itemIndex + 1).padStart(2, "0")}
                        <span>·</span>
                        {item.field}
                      </p>
                      <h3>{item.name}</h3>
                    </div>
                    <p class="catalogItemDescription">{item.description}</p>
                    <p class="catalogItemSignal">{item.signal}</p>
                    <div class="catalogItemLinks">
                      {item.links.map((link) => (
                        <a href={link.href}>{link.label} ↗</a>
                      ))}
                    </div>
                  </article>
                ))}
              </div>
            </details>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="work-contact-title" class="workContact reveal">
      <p class="eyebrow"><span>Next</span> Build with me</p>
      <h2 id="work-contact-title">
        Have a difficult workflow that should become a useful product?
      </h2>
      <div class="contactLinks">
        <a class="contactPrimary" href="/#contact">Start a conversation</a>
        <a href="https://github.com/yhay81">See all repositories ↗</a>
      </div>
    </section>
  </main>
</Base>

<style>
  .workMain {
    max-width: 1600px;
    padding-top: var(--nav-height);
  }

  .workHero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
    gap: clamp(48px, 7vw, 88px);
    align-items: center;
    max-width: 1000px;
    min-height: calc(100svh - var(--nav-height));
    padding-top: clamp(72px, 11vh, 120px);
    padding-bottom: clamp(72px, 11vh, 120px);
  }

  .eyebrow,
  .projectLabel {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-soft);
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .eyebrow {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  .eyebrow span {
    color: var(--color-accent);
  }

  .heroCopy h1 {
    margin: 20px 0 28px;
    font-size: clamp(3rem, 7vw, 4.8rem);
    font-weight: 600;
    line-height: 0.94;
    letter-spacing: -0.04em;
    text-shadow: 0 10px 30px var(--accent-glow);
  }

  .heroSummary {
    max-width: 520px;
    margin: 0;
    font-size: var(--text-lg);
    line-height: 1.5;
    color: var(--color-text-soft);
  }

  .projectIndex ol {
    padding: 0;
    margin: 0;
    list-style: none;
    border-top: 1px solid var(--border-strong);
  }

  .projectIndex li {
    border-bottom: 1px solid var(--border-strong);
  }

  .projectIndex a {
    display: grid;
    grid-template-columns: 32px 1fr auto 24px;
    gap: 16px;
    align-items: center;
    padding: 21px 0;
    color: var(--color-text-strong);
  }

  .indexNo,
  .indexField {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text);
  }

  .indexField {
    text-align: right;
  }

  .indexName {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .indexArrow {
    color: var(--color-accent);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .projectIndex a:hover .indexArrow,
  .projectIndex a:focus-visible .indexArrow {
    transform: translate(3px, 3px);
  }

  .featuredWork {
    max-width: 1000px;
    margin: 0 auto;
    border-top: 1px solid var(--border-strong);
  }

  .project {
    display: grid;
    grid-template-columns: minmax(280px, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(48px, 6vw, 76px);
    align-items: center;
    min-height: min(78vh, 780px);
    padding: clamp(80px, 10vh, 112px) 0;
    scroll-margin-top: calc(var(--nav-height) + 24px);
    border-bottom: 1px solid var(--border-strong);
  }

  .projectCopy {
    max-width: 470px;
  }

  .project:nth-child(even) {
    grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.7fr);
  }

  .project:nth-child(even) .projectCopy {
    order: 2;
  }

  .projectLabel {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .projectLabel span {
    color: var(--color-accent);
  }

  .project h2 {
    margin: 20px 0 12px;
    font-size: clamp(2.2rem, 4vw, 3.6rem);
    letter-spacing: -0.04em;
  }

  .projectRole {
    margin: 0 0 28px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text);
  }

  .projectSummary {
    margin: 0 0 18px;
    font-size: var(--text-lg);
    line-height: 1.42;
    color: var(--color-text-strong);
  }

  .projectDetail {
    margin: 0;
    color: var(--color-text-soft);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 28px 0 0;
    list-style: none;
  }

  .tags li {
    padding: 5px 10px;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-soft);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
  }

  .projectLinks,
  .contactLinks {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 24px;
    align-items: center;
    margin-top: 32px;
  }

  .projectLinks a,
  .catalogItemLinks a,
  .contactLinks a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--color-text-strong);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 6px;
  }

  .projectLinks a:hover,
  .projectLinks a:focus-visible,
  .catalogItemLinks a:hover,
  .catalogItemLinks a:focus-visible,
  .contactLinks a:hover,
  .contactLinks a:focus-visible {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .productCanvas {
    display: block;
    min-width: 0;
    min-height: 420px;
    overflow: hidden;
    color: var(--color-bg-deep);
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition:
      border-color var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
  }

  .productCanvas:hover,
  .productCanvas:focus-visible {
    color: var(--color-bg-deep);
    border-color: var(--border-accent);
    transform: translateY(-2px);
  }

  .canvasTopbar,
  .pylopdfNav,
  .hayateBar,
  .proofBar {
    display: flex;
    gap: 18px;
    align-items: center;
    min-height: 52px;
    padding: 0 clamp(18px, 3vw, 32px);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    border-bottom: 1px solid color-mix(in oklab, currentcolor 15%, transparent);
  }

  .wasmhatchCanvas {
    background: var(--color-text-strong);
  }

  .wasmMark {
    display: grid;
    width: 28px;
    height: 28px;
    color: var(--color-text-strong);
    place-items: center;
    background: var(--color-bg-deep);
    border-radius: var(--radius-sm);
  }

  .canvasStatus {
    margin-left: auto;
    font-weight: 500;
    color: color-mix(in oklab, var(--color-bg-deep) 65%, transparent);
  }

  .wasmStage {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 28px;
    min-height: 420px;
    padding: clamp(36px, 6vw, 72px);
  }

  .wasmHeadline {
    font-size: clamp(2rem, 4.2vw, 4.5rem);
    font-weight: 750;
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .wasmHeadline strong {
    color: var(--color-danger);
  }

  .wasmChat {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 7px 14px;
    width: min(100%, 460px);
    padding: 18px 20px;
    margin-left: auto;
    background: color-mix(
      in oklab,
      var(--color-text-strong) 72%,
      var(--color-info)
    );
    border: 1px solid color-mix(in oklab, var(--color-bg-deep) 18%, transparent);
    border-radius: var(--radius-md);
  }

  .chatLabel {
    grid-row: 1 / 3;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 750;
  }

  .chatRequest {
    font-size: var(--text-sm);
    font-weight: 650;
    line-height: 1.4;
  }

  .chatAction {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: color-mix(in oklab, var(--color-bg-deep) 68%, transparent);
  }

  .chatAction span {
    color: var(--color-accent);
    background: var(--color-bg-deep);
    border-radius: var(--radius-full);
  }

  .pylopdfCanvas {
    background: color-mix(
      in oklab,
      var(--color-text-strong) 87%,
      var(--color-danger)
    );
  }

  .pylopdfNav {
    color: var(--color-bg-deep);
  }

  .pyLogo {
    margin-right: auto;
    font-size: 1rem;
  }

  .pyLogo span {
    color: var(--color-violet);
  }

  .pylopdfNav > span:last-child {
    margin-left: auto;
  }

  .pylopdfStage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(150px, 0.44fr);
    gap: 24px;
    align-items: center;
    min-height: 420px;
    padding: clamp(34px, 5.5vw, 66px);
  }

  .pylopdfHeadline {
    position: relative;
    z-index: 2;
    font-family: Georgia, serif;
    font-size: clamp(1.95rem, 3.8vw, 4rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .pylopdfHeadline em {
    color: var(--color-violet);
  }

  .pdfDocument {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 280px;
    padding: 30px 24px;
    overflow: hidden;
    background: var(--color-text-strong);
    box-shadow: 12px 16px 0
      color-mix(in oklab, var(--color-violet) 22%, transparent);
    transform: rotate(3deg);
  }

  .pdfFold {
    position: absolute;
    top: 0;
    right: 0;
    width: 42px;
    height: 42px;
    background: linear-gradient(
      45deg,
      color-mix(in oklab, var(--color-info) 30%, var(--color-text-strong)) 50%,
      color-mix(in oklab, var(--color-text-strong) 80%, var(--color-info)) 50%
    );
  }

  .pdfTitle {
    margin-bottom: 36px;
    font-family: var(--font-mono);
    font-size: 2.8rem;
    font-weight: 800;
    color: var(--color-violet);
  }

  .pdfLines {
    width: 100%;
    height: 7px;
    margin-bottom: 12px;
    background: color-mix(in oklab, var(--color-bg-deep) 18%, transparent);
  }

  .pdfLines.short {
    width: 68%;
  }

  .pdfCode {
    padding: 8px 10px;
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--color-text-strong);
    background: var(--color-bg-deep);
  }

  .hayateCanvas {
    background: color-mix(
      in oklab,
      var(--color-text-strong) 92%,
      var(--color-accent)
    );
  }

  .hayateBar {
    color: var(--color-bg-deep);
    background: color-mix(
      in oklab,
      var(--color-accent) 52%,
      var(--color-text-strong)
    );
  }

  .hayateBrand {
    font-size: 1rem;
    font-weight: 800;
  }

  .hayateSearch {
    padding: 6px 10px;
    margin-left: auto;
    font-weight: 500;
    border: 1px solid color-mix(in oklab, var(--color-bg-deep) 20%, transparent);
    border-radius: var(--radius-sm);
  }

  .hayateStage {
    display: grid;
    grid-template-columns: 150px 1fr;
    min-height: 420px;
  }

  .docsNav {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 32px 24px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: color-mix(in oklab, var(--color-bg-deep) 72%, transparent);
    border-right: 1px solid
      color-mix(in oklab, var(--color-bg-deep) 13%, transparent);
  }

  .docsNav strong {
    margin-top: 10px;
    color: var(--color-bg-deep);
  }

  .docsContent {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(36px, 5vw, 64px);
  }

  .docsOverline {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 800;
    color: color-mix(in oklab, var(--color-bg-deep) 60%, transparent);
    letter-spacing: 0.12em;
  }

  .docsTitle {
    margin: 12px 0 16px;
    font-size: clamp(1.9rem, 3.5vw, 3.5rem);
    font-weight: 750;
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .docsText {
    font-size: var(--text-sm);
    color: color-mix(in oklab, var(--color-bg-deep) 72%, transparent);
  }

  .codePanel {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 18px 20px;
    margin-top: auto;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 0.69rem;
    color: var(--color-code-text);
    background: var(--color-code-bg);
    border-radius: var(--radius-sm);
  }

  .codePanel i {
    color: var(--color-code-keyword);
  }

  .codePanel b {
    color: var(--color-code-command);
  }

  .codePanel q {
    color: var(--color-code-string);
  }

  .proofLockCanvas {
    background: color-mix(
      in oklab,
      var(--color-text-strong) 88%,
      var(--color-accent)
    );
  }

  .proofBar {
    color: var(--color-bg-deep);
  }

  .proofMark {
    display: grid;
    width: 28px;
    height: 28px;
    color: var(--color-bg-deep);
    place-items: center;
    background: var(--color-accent);
    border-radius: var(--radius-full);
  }

  .proofStatus {
    margin-left: auto;
    font-weight: 500;
    color: color-mix(in oklab, var(--color-bg-deep) 64%, transparent);
  }

  .proofStage {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 420px;
    padding: clamp(34px, 5.5vw, 64px);
  }

  .proofKicker {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 800;
    color: color-mix(in oklab, var(--color-bg-deep) 60%, transparent);
    letter-spacing: 0.16em;
  }

  .proofHeadline {
    margin-top: 16px;
    font-size: clamp(2rem, 3.9vw, 4rem);
    font-weight: 780;
    line-height: 1;
    letter-spacing: -0.055em;
  }

  .proofHeadline strong {
    color: color-mix(in oklab, var(--color-bg-deep) 72%, var(--color-accent));
  }

  .proofPanel {
    width: 100%;
    margin-top: 38px;
    overflow: hidden;
    background: color-mix(
      in oklab,
      var(--color-text-strong) 72%,
      var(--color-accent)
    );
    border: 1px solid color-mix(in oklab, var(--color-bg-deep) 16%, transparent);
    border-radius: var(--radius-sm);
  }

  .proofRow {
    display: grid;
    grid-template-columns: minmax(120px, 0.34fr) minmax(140px, 1fr) auto;
    gap: 14px;
    align-items: center;
    padding: 13px 16px;
    font-family: var(--font-mono);
    font-size: 0.67rem;
    border-bottom: 1px solid
      color-mix(in oklab, var(--color-bg-deep) 12%, transparent);
  }

  .proofRow:last-child {
    border-bottom: 0;
  }

  .proofSurface {
    font-weight: 800;
  }

  .proofTrace {
    color: color-mix(in oklab, var(--color-bg-deep) 58%, transparent);
  }

  .proofPass,
  .proofGuard {
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .proofPass {
    color: color-mix(in oklab, var(--color-bg-deep) 64%, var(--color-accent));
  }

  .proofGuard {
    color: var(--color-danger);
  }

  .proofFoot {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.61rem;
    color: color-mix(in oklab, var(--color-bg-deep) 55%, transparent);
  }

  .workCatalog,
  .workContact {
    max-width: 1000px;
  }

  /* stylelint-disable no-descending-specificity -- Astro scopes this catalog;
     shared element selectors above cannot affect its cascade. */
  .catalogHeader {
    display: grid;
    grid-template-columns: minmax(250px, 0.42fr) minmax(0, 0.58fr);
    gap: clamp(44px, 7vw, 88px);
    align-items: start;
    margin-bottom: clamp(32px, 5vw, 48px);
  }

  .catalogHeader h2,
  .workContact h2 {
    font-size: clamp(2rem, 3.8vw, 3.2rem);
    letter-spacing: -0.035em;
  }

  .catalogHeader h2 {
    margin-top: 16px;
    scroll-margin-top: calc(var(--nav-height) + 72px);
  }

  .catalogIntroduction {
    max-width: 650px;
    margin: 0;
    font-size: var(--text-lg);
    color: var(--color-text-soft);
  }

  .catalogGroupIndex,
  .catalogGroupAction,
  .catalogItemMeta,
  .catalogItemSignal {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }

  .catalogGroups {
    border-top: 1px solid var(--border-strong);
  }

  .catalogGroup {
    border-bottom: 1px solid var(--border-strong);
    scroll-margin-top: calc(var(--nav-height) + 24px);
  }

  .catalogGroup summary {
    display: grid;
    grid-template-columns: 38px minmax(300px, 1fr) minmax(128px, auto) 18px;
    gap: 24px;
    align-items: center;
    padding: 17px 0;
    cursor: pointer;
    list-style: none;
    transition:
      color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }

  .catalogGroup summary::-webkit-details-marker {
    display: none;
  }

  .catalogGroup summary:hover {
    background: color-mix(in oklab, var(--color-accent) 5%, transparent);
  }

  .catalogGroup summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
  }

  .catalogGroup[open] summary {
    border-bottom: 1px solid var(--border-subtle);
  }

  .catalogGroupIndex {
    grid-column: 1;
    color: var(--color-text);
  }

  .catalogGroupHeading {
    display: grid;
    grid-column: 2;
    gap: 6px;
  }

  .catalogGroupHeading small {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-soft);
  }

  .catalogGroupHeading b {
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .catalogGroupDescription {
    display: none;
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  .catalogGroup[open] .catalogGroupDescription {
    display: block;
    grid-row: 2;
    grid-column: 2 / 4;
    max-width: 680px;
    padding-bottom: 6px;
  }

  .catalogGroupAction {
    grid-column: 3;
    min-width: 128px;
    color: var(--color-text);
    text-align: right;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .catalogGroupOpened {
    display: none;
  }

  .catalogGroup[open] .catalogGroupClosed {
    display: none;
  }

  .catalogGroup[open] .catalogGroupOpened {
    display: inline;
    color: var(--color-accent);
  }

  .catalogGroupToggle {
    grid-column: 4;
    width: 10px;
    height: 10px;
    border-right: 1.5px solid currentcolor;
    border-bottom: 1.5px solid currentcolor;
    transform: rotate(45deg) translate(-2px, -2px);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .catalogGroup[open] .catalogGroupToggle {
    color: var(--color-accent);
    transform: rotate(225deg) translate(-2px, -2px);
  }

  .catalogItems {
    padding-bottom: 28px;
    animation: catalog-group-enter var(--dur-slow) var(--ease-out) both;
  }

  @keyframes catalog-group-enter {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .catalogItem {
    display: grid;
    grid-template-columns:
      minmax(96px, 0.15fr) minmax(170px, 0.27fr) minmax(250px, 0.42fr)
      minmax(120px, 0.16fr) auto;
    gap: 24px;
    align-items: center;
    padding: 30px 0;
    border-bottom: 1px solid var(--border-subtle);
    scroll-margin-top: calc(var(--nav-height) + 24px);
  }

  .catalogItem:last-child {
    border-bottom: 0;
  }

  .catalogItemVisual {
    position: relative;
    min-width: 0;
    min-height: 88px;
    overflow: hidden;
    color: var(--color-text-strong);
    background:
      radial-gradient(
        circle at var(--visual-x) var(--visual-y),
        var(--color-accent) 0 2px,
        transparent 3px
      ),
      linear-gradient(
        90deg,
        transparent calc(var(--visual-x) - 0.5px),
        color-mix(in oklab, var(--color-accent) 35%, transparent)
          var(--visual-x),
        transparent calc(var(--visual-x) + 0.5px)
      ),
      linear-gradient(
        transparent calc(var(--visual-y) - 0.5px),
        color-mix(in oklab, var(--color-text-strong) 14%, transparent)
          var(--visual-y),
        transparent calc(var(--visual-y) + 0.5px)
      ),
      color-mix(in oklab, var(--surface-card) 84%, var(--color-bg-deep));
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    transition:
      border-color var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }

  .catalogItemVisual[data-family="2"] {
    background:
      radial-gradient(
        circle at var(--visual-x) var(--visual-y),
        var(--color-accent) 0 2px,
        transparent 3px
      ),
      repeating-linear-gradient(
        0deg,
        transparent 0 10px,
        color-mix(in oklab, var(--color-text-strong) 8%, transparent) 10px 11px
      ),
      color-mix(in oklab, var(--surface-card) 90%, var(--color-bg-deep));
  }

  .catalogItemVisual[data-family="3"] {
    background:
      radial-gradient(
        circle at var(--visual-x) var(--visual-y),
        var(--color-accent) 0 2px,
        transparent 3px
      ),
      repeating-linear-gradient(
        135deg,
        transparent 0 12px,
        color-mix(in oklab, var(--color-accent) 9%, transparent) 12px 13px
      ),
      color-mix(in oklab, var(--surface-card) 86%, var(--color-bg-deep));
  }

  .catalogItemVisual[data-family="4"] {
    background:
      radial-gradient(
        circle at var(--visual-x) var(--visual-y),
        var(--color-accent) 0 2px,
        transparent 3px
      ),
      radial-gradient(
          circle,
          color-mix(in oklab, var(--color-text-strong) 13%, transparent) 0 1px,
          transparent 1.5px
        )
        0 0 / 12px 12px,
      color-mix(in oklab, var(--surface-card) 88%, var(--color-bg-deep));
  }

  .catalogItemVisual[data-family="5"] {
    background:
      linear-gradient(
        115deg,
        transparent 0 var(--visual-x),
        color-mix(in oklab, var(--color-accent) 16%, transparent)
          var(--visual-x) calc(var(--visual-x) + 18%),
        transparent calc(var(--visual-x) + 18%)
      ),
      color-mix(in oklab, var(--surface-card) 88%, var(--color-bg-deep));
  }

  .catalogVisualChrome {
    display: flex;
    gap: 4px;
    align-items: center;
    height: 22px;
    padding: 0 8px;
    border-bottom: 1px solid
      color-mix(in oklab, var(--color-text-strong) 10%, transparent);
  }

  .catalogVisualChrome i {
    width: 3px;
    height: 3px;
    background: color-mix(in oklab, var(--color-text-strong) 36%, transparent);
    border-radius: var(--radius-full);
  }

  .catalogVisualChrome i:first-child {
    background: var(--color-accent);
  }

  .catalogVisualChrome b {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.48rem;
    font-weight: 600;
    color: color-mix(in oklab, var(--color-text-strong) 48%, transparent);
    letter-spacing: 0.06em;
  }

  .catalogItemVisual > strong {
    position: absolute;
    bottom: 10px;
    left: 11px;
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  .catalogVisualTrace {
    position: absolute;
    right: 10px;
    bottom: 12px;
    width: 26px;
    height: 12px;
    border-right: 1px solid
      color-mix(in oklab, var(--color-text-strong) 20%, transparent);
    border-bottom: 1px solid
      color-mix(in oklab, var(--color-text-strong) 20%, transparent);
  }

  .catalogVisualTrace i,
  .catalogVisualTrace b {
    position: absolute;
    display: block;
    background: var(--color-accent);
    border-radius: var(--radius-full);
  }

  .catalogVisualTrace i {
    right: -2px;
    bottom: -2px;
    width: 4px;
    height: 4px;
  }

  .catalogVisualTrace b {
    top: -1px;
    left: -1px;
    width: 3px;
    height: 3px;
  }

  .catalogItem:hover .catalogItemVisual {
    border-color: var(--border-accent);
    transform: translateY(-2px);
  }

  .catalogItemLead {
    margin: 24px 0 12px;
    padding: clamp(26px, 4vw, 42px);
    color: var(--color-bg-deep);
    background:
      radial-gradient(
        circle at 92% 0%,
        color-mix(in oklab, var(--color-accent) 18%, transparent),
        transparent 36%
      ),
      color-mix(in oklab, var(--color-text-strong) 94%, var(--color-info));
    border: 1px solid color-mix(in oklab, var(--color-bg-deep) 16%, transparent);
    border-radius: var(--radius-md);
  }

  .catalogItemLead h3,
  .catalogItemLead .catalogItemLinks a {
    color: var(--color-bg-deep);
  }

  .catalogItemLead .catalogItemMeta,
  .catalogItemLead .catalogItemSignal {
    color: color-mix(in oklab, var(--color-bg-deep) 64%, transparent);
  }

  .catalogItemLead .catalogItemDescription {
    color: color-mix(in oklab, var(--color-bg-deep) 76%, transparent);
  }

  .catalogItemLead .catalogItemVisual {
    color: var(--color-text-strong);
    background-color: var(--color-bg-deep);
    border-color: color-mix(in oklab, var(--color-bg-deep) 24%, transparent);
  }

  .catalogItemLead .catalogItemLinks a {
    text-decoration-color: color-mix(
      in oklab,
      var(--color-bg-deep) 34%,
      transparent
    );
  }

  .catalogItemLead .catalogItemLinks a:hover,
  .catalogItemLead .catalogItemLinks a:focus-visible {
    color: color-mix(in oklab, var(--color-bg-deep) 68%, var(--color-violet));
    text-decoration-color: currentcolor;
  }

  .catalogItemHeading {
    display: grid;
    gap: 8px;
  }

  .catalogItemMeta {
    margin: 0;
    color: var(--color-text);
  }

  .catalogItemMeta span {
    margin: 0 4px;
    color: var(--color-accent);
  }

  .catalogItem h3 {
    font-size: var(--text-xl);
    letter-spacing: -0.02em;
  }

  .catalogItemLead h3 {
    font-size: clamp(1.7rem, 3vw, 2.4rem);
  }

  .catalogItemDescription {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  .catalogItemSignal {
    margin: 0;
    line-height: 1.55;
    color: var(--color-text);
  }

  .catalogItemLinks {
    display: flex;
    flex-direction: column;
    gap: 9px;
    align-items: flex-start;
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  /* stylelint-enable no-descending-specificity */
  .workContact {
    display: grid;
    grid-template-columns: minmax(180px, 0.35fr) minmax(0, 0.65fr);
    gap: 48px;
    align-items: start;
    border-top: 1px solid var(--border-strong);
  }

  .workContact h2,
  .workContact .contactLinks {
    grid-column: 2;
  }

  .contactPrimary {
    padding: 12px 18px;
    color: var(--color-bg-deep);
    text-decoration: none;
    background: var(--color-accent);
    border-radius: var(--radius-sm);
  }

  .contactPrimary:hover,
  .contactPrimary:focus-visible {
    color: var(--color-bg-deep);
    background: var(--color-text-strong);
  }

  @media (width <= 960px) {
    .workHero,
    .project {
      grid-template-columns: 1fr;
    }

    .workHero {
      gap: 64px;
      align-content: center;
    }

    .project {
      gap: 48px;
      min-height: 0;
    }

    .project:nth-child(even) {
      grid-template-columns: 1fr;
    }

    .projectCopy {
      max-width: 680px;
    }

    .project:nth-child(even) .projectCopy {
      order: 0;
    }

    .productCanvas {
      min-height: 430px;
    }

    .catalogGroup summary {
      grid-template-columns: 36px minmax(260px, 1fr) minmax(128px, auto) 18px;
    }

    .catalogItem {
      grid-template-columns: 104px minmax(180px, 0.38fr) minmax(0, 0.62fr);
    }

    .catalogItemVisual {
      grid-row: 1 / 3;
      grid-column: 1;
    }

    .catalogItemHeading {
      grid-column: 2;
    }

    .catalogItemDescription {
      grid-column: 3;
    }

    .catalogItemSignal,
    .catalogItemLinks {
      grid-column: 2 / 4;
    }

    .catalogItemLinks {
      flex-flow: row wrap;
    }
  }

  @media (width <= 640px) {
    .workMain {
      padding-right: var(--page-padding);
      padding-left: var(--page-padding);
    }

    .workHero {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
      min-height: auto;
      padding-top: 64px;
      padding-bottom: 48px;
    }

    .heroCopy h1 {
      font-size: clamp(3rem, 16vw, 4.2rem);
    }

    .projectIndex a {
      grid-template-columns: 28px 1fr 20px;
      gap: 10px;
      padding: 16px 0;
    }

    .indexField {
      display: none;
    }

    .project {
      grid-template-columns: minmax(0, 1fr);
      padding: 80px 0;
    }

    .projectSummary {
      font-size: var(--text-lg);
    }

    .productCanvas {
      min-height: 380px;
    }

    .wasmStage,
    .pylopdfStage,
    .docsContent,
