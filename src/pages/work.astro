  .workCatalog,
  .workContact {
    max-width: 1000px;
  }

  /* stylelint-disable no-descending-specificity -- Astro scopes this catalog;
     shared element selectors above cannot affect its cascade. */
  .catalogHeader {
    display: grid;
    grid-template-columns: minmax(250px, 0.42fr) minmax(0, 0.58fr);
    gap: clamp(44px, 7vw, 88px);
    align-items: start;
    margin-bottom: clamp(48px, 7vw, 72px);
  }

  .catalogHeader h2,
  .workContact h2 {
    font-size: clamp(2rem, 3.8vw, 3.2rem);
    letter-spacing: -0.035em;
  }

  .catalogHeader h2 {
    margin-top: 16px;
    scroll-margin-top: calc(var(--nav-height) + 72px);
  }

  .catalogIntroduction {
    max-width: 650px;
    margin: 0;
    font-size: var(--text-lg);
    color: var(--color-text-soft);
  }

  .catalogNavigation {
    margin-bottom: clamp(44px, 6vw, 68px);
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }

  .catalogNavigation ol {
    display: grid;
    grid-template-columns: repeat(5, minmax(170px, 1fr));
    min-width: 850px;
    padding: 0;
    margin: 0;
    list-style: none;
    border-top: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
  }

  .catalogNavigation li + li {
    border-left: 1px solid var(--border-subtle);
  }

  .catalogNavigation a {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 12px;
    min-height: 118px;
    padding: 20px;
    color: var(--color-text-strong);
    transition:
      color var(--dur-base) var(--ease-out),
      background-color var(--dur-base) var(--ease-out);
  }

  .catalogNavigation a:hover,
  .catalogNavigation a:focus-visible {
    color: var(--color-bg-deep);
    background: var(--color-accent);
  }

  .catalogNavigation span,
  .catalogNavigation small,
  .catalogGroupIndex,
  .catalogGroupCount,
  .catalogItemMeta,
  .catalogItemSignal {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }

  .catalogNavigation span {
    color: var(--color-text);
  }

  .catalogNavigation a:hover span,
  .catalogNavigation a:focus-visible span,
  .catalogNavigation a:hover small,
  .catalogNavigation a:focus-visible small {
    color: color-mix(in oklab, var(--color-bg-deep) 72%, transparent);
  }

  .catalogNavigation b {
    align-self: start;
    font-size: var(--text-sm);
  }

  .catalogNavigation small {
    grid-column: 2;
    align-self: end;
    color: var(--color-text-soft);
  }

  .catalogGroups {
    border-top: 1px solid var(--border-strong);
  }

  .catalogGroup {
    border-bottom: 1px solid var(--border-strong);
    scroll-margin-top: calc(var(--nav-height) + 24px);
  }

  .catalogGroup summary {
    display: grid;
    grid-template-columns:
      38px minmax(220px, 0.34fr) minmax(260px, 0.66fr)
      34px 20px;
    gap: 24px;
    align-items: center;
    padding: 30px 0;
    cursor: pointer;
    list-style: none;
    transition: background-color var(--dur-base) var(--ease-out);
  }

  .catalogGroup summary::-webkit-details-marker {
    display: none;
  }

  .catalogGroup summary:hover {
    background: color-mix(in oklab, var(--color-accent) 6%, transparent);
  }

  .catalogGroup summary:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 6px;
  }

  .catalogGroupIndex,
  .catalogGroupCount {
    color: var(--color-text);
  }

  .catalogGroupHeading {
    display: grid;
    gap: 6px;
  }

  .catalogGroupHeading small {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-soft);
  }

  .catalogGroupHeading b {
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.12;
    letter-spacing: -0.025em;
  }

  .catalogGroupDescription {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  .catalogGroupCount {
    text-align: right;
  }

  .catalogGroupToggle {
    position: relative;
    display: block;
    width: 20px;
    height: 20px;
    color: var(--color-text-strong);
  }

  .catalogGroupToggle::before,
  .catalogGroupToggle::after {
    position: absolute;
    top: 9px;
    left: 3px;
    width: 14px;
    height: 2px;
    content: "";
    background: currentcolor;
    transition: transform var(--dur-base) var(--ease-out);
  }

  .catalogGroupToggle::after {
    transform: rotate(90deg);
  }

  .catalogGroup[open] .catalogGroupToggle::after {
    transform: rotate(90deg) scaleX(0);
  }

  .catalogGroup[open] summary {
    border-bottom: 1px solid var(--border-subtle);
  }

  .catalogItems {
    padding-bottom: 28px;
  }

  .catalogItem {
    display: grid;
    grid-template-columns:
      minmax(205px, 0.3fr) minmax(280px, 0.46fr)
      minmax(135px, 0.16fr) auto;
