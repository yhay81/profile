---
import Base from "@/layouts/Base.astro";

const FEATURED_PROJECTS = [
  {
    id: "wasmhatch",
    index: "01",
    name: "WasmHatch",
    field: "Browser-native AI",
  },
  {
    id: "pylopdf",
    index: "02",
    name: "pylopdf",
    field: "Python + Rust",
  },
  {
    id: "hayate",
    index: "03",
    name: "hayate",
    field: "Web standards",
  },
  {
    id: "public-data-catalog",
    index: "04",
    name: "Public Data Catalog",
    field: "Verifiable data",
  },
] as const;
---

<Base
  description="Selected products and open-source systems by Yusuke Hayashi across browser-native AI, Python and Rust tooling, web standards, and verifiable public data."
  path="/work"
  title="Selected Work | Yusuke Hayashi"
>
  <main class="workMain">
    <section aria-labelledby="work-title" class="workHero">
      <div class="heroCopy">
        <p class="eyebrow">Products &amp; open source</p>
        <h1 data-view-transition-name="page-title" id="work-title">
          Selected<br />Work
        </h1>
        <p class="heroSummary">
          I build products and open-source systems that make complex
          capabilities usable, verifiable, and portable.
        </p>
      </div>

      <nav aria-label="Featured projects" class="projectIndex">
        <ol>
          {
            FEATURED_PROJECTS.map((project) => (
              <li>
                <a href={`#${project.id}`}>
                  <span class="indexNo">{project.index}</span>
                  <span class="indexName">{project.name}</span>
                  <span class="indexField">{project.field}</span>
                  <span aria-hidden="true" class="indexArrow">
                    ↘
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </section>

    <div class="featuredWork">
      <article class="project reveal" id="wasmhatch">
        <div class="projectCopy">
          <p class="projectLabel">
            <span>01</span>
            Browser-native AI
          </p>
          <h2>WasmHatch</h2>
          <p class="projectRole">Lead builder · Haya Inc. · Open source</p>
          <p class="projectSummary">
            An AI assistant that does the work directly in Google Docs, Sheets,
            and Slides — without a server, install, or account.
          </p>
          <p class="projectDetail">
            The product runs in the browser, supports user-supplied models and
            Chrome AI, and keeps every proposed change visible and undoable.
          </p>
          <ul aria-label="WasmHatch technologies" class="tags">
            <li>WebAssembly</li>
            <li>Browser AI</li>
            <li>Office workflows</li>
          </ul>
          <div class="projectLinks">
            <a href="https://wasmhatch.com/?view=chat">Open product ↗</a>
            <a href="https://github.com/haya-inc/wasmhatch">Source ↗</a>
          </div>
        </div>

        <a
          aria-label="Open WasmHatch"
          class="productCanvas wasmhatchCanvas"
          href="https://wasmhatch.com/?view=chat"
        >
          <span class="canvasTopbar">
            <span class="wasmMark">W</span>
            <span>WasmHatch</span>
            <span class="canvasStatus">Local session</span>
          </span>
          <span class="wasmStage">
            <span class="wasmHeadline">
              The assistant<br />
              that <strong>does</strong> the work.
            </span>
            <span class="wasmChat">
              <span class="chatLabel">YOU</span>
              <span class="chatRequest">
                Turn this outline into a finished launch brief.
              </span>
              <span class="chatAction">
                <span aria-hidden="true">✓</span>
                6 visible edits ready to review
              </span>
            </span>
          </span>
        </a>
      </article>

      <article class="project reveal" id="pylopdf">
        <div class="projectCopy">
          <p class="projectLabel"><span>02</span> Python + Rust</p>
          <h2>pylopdf</h2>
          <p class="projectRole">Creator and maintainer · MIT</p>
          <p class="projectSummary">
            A compact Python API for editing, rendering, extracting, and
            generating PDFs, backed by a Rust core.
          </p>
          <p class="projectDetail">
            It combines Python ergonomics with small wheels and no mandatory
            Python dependencies, providing a permissive alternative for
            production PDF workflows.
          </p>
          <ul aria-label="pylopdf technologies" class="tags">
            <li>Python</li>
            <li>Rust</li>
            <li>PDF</li>
          </ul>
          <div class="projectLinks">
            <a href="https://yhay81.github.io/pylopdf/">Read the docs ↗</a>
            <a href="https://pypi.org/project/pylopdf/">PyPI ↗</a>
            <a href="https://github.com/yhay81/pylopdf">Source ↗</a>
          </div>
        </div>

        <a
          aria-label="Read the pylopdf documentation"
          class="productCanvas pylopdfCanvas"
          href="https://yhay81.github.io/pylopdf/"
        >
          <span class="pylopdfNav">
            <span class="pyLogo">py<span>lo</span>pdf</span>
            <span>Docs</span>
            <span>API</span>
            <span>GitHub ↗</span>
          </span>
          <span class="pylopdfStage">
            <span class="pylopdfHeadline">
              PDFs, with Python<br />
              ergonomics and a<br />
              <em>Rust core.</em>
            </span>
            <span class="pdfDocument">
              <span class="pdfFold"></span>
              <span class="pdfTitle">PDF</span>
              <span class="pdfLines"></span>
              <span class="pdfLines short"></span>
              <span class="pdfCode">doc.save("output.pdf")</span>
            </span>
          </span>
        </a>
      </article>

      <article class="project reveal" id="hayate">
        <div class="projectCopy">
          <p class="projectLabel"><span>03</span> Web standards</p>
          <h2>hayate</h2>
          <p class="projectRole">Creator and maintainer · MIT</p>
          <p class="projectSummary">
            A standards-first Python web framework built around WHATWG Fetch,
            URL, and URLPattern.
          </p>
          <p class="projectDetail">
            The same application model moves across ASGI, Cloudflare Workers,
            and AWS Lambda instead of making deployment targets define the
            programming model.
          </p>
          <ul aria-label="hayate technologies" class="tags">
            <li>Python</li>
            <li>WHATWG Fetch</li>
            <li>Edge runtimes</li>
          </ul>
          <div class="projectLinks">
            <a href="https://hayatepy.github.io/hayate/">Read the docs ↗</a>
            <a href="https://pypi.org/project/hayate/">PyPI ↗</a>
            <a href="https://github.com/hayatepy/hayate">Source ↗</a>
          </div>
        </div>

        <a
          aria-label="Read the hayate documentation"
          class="productCanvas hayateCanvas"
          href="https://hayatepy.github.io/hayate/"
        >
          <span class="hayateBar">
            <span class="hayateBrand">hayate</span>
            <span>Documentation</span>
            <span class="hayateSearch">Search docs&nbsp; ⌘K</span>
          </span>
          <span class="hayateStage">
            <span class="docsNav">
              <strong>Getting started</strong>
              <span>Installation</span>
              <span>Quick start</span>
              <span>Routing</span>
              <strong>Deploy</strong>
              <span>ASGI</span>
              <span>Workers</span>
            </span>
            <span class="docsContent">
              <span class="docsOverline">QUICK START</span>
              <span class="docsTitle"
                >Web standards,<br />native to Python.</span
              >
              <span class="docsText"> One request model. Every runtime. </span>
              <span class="codePanel">
                <span><i>from</i> hayate <i>import</i> Hayate</span>
                <span>&nbsp;</span>
                <span>app = Hayate()</span>
                <span><b>@app.get</b>(<q>"/hello"</q>)</span>
              </span>
            </span>
          </span>
        </a>
      </article>

      <article class="project reveal" id="public-data-catalog">
        <div class="projectCopy">
          <p class="projectLabel"><span>04</span> Verifiable data</p>
          <h2>Public Data Catalog</h2>
          <p class="projectRole">Creator and maintainer · Open source</p>
          <p class="projectSummary">
            A Japanese-first catalog of tested public-data retrieval recipes
            designed for people and AI agents.
          </p>
          <p class="projectDetail">
            Each recipe carries provenance, licensing, freshness, and an
            executable path so agents can do more than point at a dataset.
          </p>
          <ul aria-label="Public Data Catalog technologies" class="tags">
            <li>MCP</li>
            <li>Open data</li>
            <li>Provenance</li>
          </ul>
          <div class="projectLinks">
            <a href="https://public-data-catalog-mcp.yusuke8h.workers.dev/">
              Open catalog ↗
            </a>
            <a href="https://github.com/yhay81/public-data-catalog">
              Source ↗
            </a>
          </div>
        </div>

        <a
          aria-label="Open Public Data Catalog"
          class="productCanvas catalogCanvas"
          href="https://public-data-catalog-mcp.yusuke8h.workers.dev/"
        >
          <span class="catalogBar">
            <span class="catalogMark">公</span>
            <span>Public Data Catalog</span>
            <span class="catalogOnline">● MCP online</span>
          </span>
          <span class="catalogStage">
            <span class="catalogHeadline">
              公的データを、<br /><strong>AIで使う。</strong>
            </span>
            <span class="catalogCopy">
              出典・ライセンス・鮮度を保ったまま、取得から検証まで。
            </span>
            <span class="catalogConnection">
              <small>CONNECTION URL</small>
              <span>…workers.dev/mcp</span>
              <b>Copy</b>
            </span>
            <span class="catalogStats">
              <span><b>Tested</b> recipes</span>
              <span><b>Live</b> verification</span>
              <span><b>Open</b> provenance</span>
            </span>
          </span>
        </a>
      </article>
    </div>

    <section aria-labelledby="more-work-title" class="moreWork reveal">
      <header class="moreHeader">
        <p class="eyebrow">More work</p>
        <h2 id="more-work-title">Useful, maintained, and exploratory.</h2>
      </header>

      <div class="moreList">
        <article class="moreProject">
          <div>
            <p class="moreMeta">05 · Google Apps Script</p>
            <h3>GASlacker</h3>
          </div>
          <p>
            A zero-runtime-dependency Slack Web API client for Google Apps
            Script, with broad API coverage, retries, uploads, and OAuth.
          </p>
          <div class="moreLinks">
            <a href="https://yhay81.github.io/GASlacker/">Website ↗</a>
            <a href="https://github.com/yhay81/GASlacker">Source ↗</a>
          </div>
        </article>

        <article class="moreProject">
          <div>
            <p class="moreMeta">06 · Interactive experiment</p>
            <h3>Code Sortings</h3>
          </div>
          <p>
            Sorting algorithms executed in Python through Pyodide and a Web
            Worker, then translated into an interactive visual trace.
          </p>
          <div class="moreLinks">
            <a href="https://sort.yusuke-hayashi.com">Open experiment ↗</a>
            <a href="https://github.com/yhay81/code-sortings">Source ↗</a>
          </div>
        </article>
      </div>
    </section>

    <section aria-labelledby="work-contact-title" class="workContact reveal">
      <p class="eyebrow">Build with me</p>
      <h2 id="work-contact-title">
        Have a difficult workflow that should become a useful product?
      </h2>
      <div class="contactLinks">
        <a class="contactPrimary" href="/#contact">Start a conversation</a>
        <a href="https://github.com/yhay81">See all repositories ↗</a>
      </div>
    </section>
  </main>
</Base>

<style>
  .workMain {
    max-width: none;
    padding-top: var(--nav-height);
  }

  .workHero {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
    gap: clamp(48px, 8vw, 120px);
    align-items: end;
    max-width: 1280px;
    min-height: calc(100svh - var(--nav-height));
    padding-top: clamp(72px, 12vh, 140px);
    padding-bottom: clamp(72px, 12vh, 140px);
  }

  .eyebrow,
  .projectLabel,
  .moreMeta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .heroCopy h1 {
    margin: 20px 0 28px;
    font-size: clamp(4rem, 10vw, 9rem);
    font-weight: 650;
    line-height: 0.82;
    letter-spacing: -0.075em;
    text-shadow: 0 20px 60px var(--info-glow);
  }

  .heroSummary {
    max-width: 640px;
    margin: 0;
    font-size: clamp(1.15rem, 2vw, 1.55rem);
    line-height: 1.5;
    color: var(--color-text-soft);
  }

  .projectIndex ol {
    padding: 0;
    margin: 0;
    list-style: none;
    border-top: 1px solid var(--border-strong);
  }

  .projectIndex li {
    border-bottom: 1px solid var(--border-strong);
  }

  .projectIndex a {
    display: grid;
    grid-template-columns: 32px 1fr auto 24px;
    gap: 16px;
    align-items: center;
    padding: 21px 0;
    color: var(--color-text-strong);
  }

  .indexNo,
  .indexField {
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text);
  }

  .indexField {
    text-align: right;
  }

  .indexName {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .indexArrow {
    color: var(--color-accent);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .projectIndex a:hover .indexArrow,
  .projectIndex a:focus-visible .indexArrow {
    transform: translate(3px, 3px);
  }

  .featuredWork {
    max-width: 1280px;
    margin: 0 auto;
    border-top: 1px solid var(--border-strong);
  }

  .project {
    display: grid;
    grid-template-columns: minmax(280px, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(48px, 7vw, 104px);
    align-items: center;
    min-height: min(86vh, 920px);
    padding: clamp(88px, 12vh, 144px) 0;
    scroll-margin-top: calc(var(--nav-height) + 24px);
    border-bottom: 1px solid var(--border-strong);
  }

  .projectCopy {
    max-width: 470px;
  }

  .project:nth-child(even) {
    grid-template-columns: minmax(0, 1.3fr) minmax(280px, 0.7fr);
  }

  .project:nth-child(even) .projectCopy {
    order: 2;
  }

  .projectLabel {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .projectLabel span {
    color: var(--color-text);
  }

  .project h2 {
    margin: 20px 0 12px;
    font-size: clamp(2.4rem, 5vw, 4.8rem);
    letter-spacing: -0.055em;
  }

  .projectRole {
    margin: 0 0 28px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text);
  }

  .projectSummary {
    margin: 0 0 18px;
    font-size: var(--text-xl);
    line-height: 1.42;
    color: var(--color-text-strong);
  }

  .projectDetail {
    margin: 0;
    color: var(--color-text-soft);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    margin: 28px 0 0;
    list-style: none;
  }

  .tags li {
    padding: 5px 10px;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-soft);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-full);
  }

  .projectLinks,
  .contactLinks {
    display: flex;
    flex-wrap: wrap;
    gap: 14px 24px;
    align-items: center;
    margin-top: 32px;
  }

  .projectLinks a,
  .moreLinks a,
  .contactLinks a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 650;
    color: var(--color-text-strong);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 6px;
  }

  .projectLinks a:hover,
  .projectLinks a:focus-visible,
  .moreLinks a:hover,
  .moreLinks a:focus-visible,
  .contactLinks a:hover,
  .contactLinks a:focus-visible {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .productCanvas {
    display: block;
    min-width: 0;
    min-height: 480px;
    overflow: hidden;
    color: var(--color-bg-deep);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    box-shadow: 0 28px 80px
      color-mix(in oklab, var(--color-bg-deep) 55%, transparent);
    transition:
      border-color var(--dur-slow) var(--ease-out),
      transform var(--dur-slow) var(--ease-out);
  }

  .productCanvas:hover,
  .productCanvas:focus-visible {
    color: var(--color-bg-deep);
    border-color: var(--border-accent);
    transform: translateY(-4px);
  }

  .canvasTopbar,
  .pylopdfNav,
  .hayateBar,
  .catalogBar {
    display: flex;
    gap: 18px;
    align-items: center;
    min-height: 58px;
    padding: 0 clamp(18px, 3vw, 32px);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    border-bottom: 1px solid color-mix(in oklab, currentcolor 15%, transparent);
  }

  .wasmhatchCanvas {
    background: var(--color-text-strong);
  }

  .wasmMark {
    display: grid;
    width: 28px;
    height: 28px;
    color: var(--color-text-strong);
    place-items: center;
    background: var(--color-bg-deep);
    border-radius: var(--radius-sm);
  }

  .canvasStatus {
    margin-left: auto;
    font-weight: 500;
    color: color-mix(in oklab, var(--color-bg-deep) 65%, transparent);
  }

  .wasmStage {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 28px;
    min-height: 420px;
    padding: clamp(36px, 6vw, 72px);
  }

  .wasmHeadline {
    font-size: clamp(2rem, 4.2vw, 4.5rem);
    font-weight: 750;
    line-height: 0.95;
    letter-spacing: -0.06em;
  }

  .wasmHeadline strong {
    color: var(--color-danger);
  }

  .wasmChat {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 7px 14px;
    width: min(100%, 460px);
    padding: 18px 20px;
    margin-left: auto;
    background: color-mix(
      in oklab,
      var(--color-text-strong) 72%,
      var(--color-info)
    );
    border: 1px solid color-mix(in oklab, var(--color-bg-deep) 18%, transparent);
    border-radius: var(--radius-md);
  }

  .chatLabel {
    grid-row: 1 / 3;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 750;
  }

  .chatRequest {
    font-size: var(--text-sm);
    font-weight: 650;
    line-height: 1.4;
  }

  .chatAction {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: color-mix(in oklab, var(--color-bg-deep) 68%, transparent);
  }

  .chatAction span {
    color: var(--color-accent);
    background: var(--color-bg-deep);
    border-radius: var(--radius-full);
  }

  .pylopdfCanvas {
    background: color-mix(
      in oklab,
      var(--color-text-strong) 87%,
      var(--color-danger)
    );
  }

  .pylopdfNav {
    color: var(--color-bg-deep);
  }

  .pyLogo {
    margin-right: auto;
    font-size: 1rem;
  }

  .pyLogo span {
    color: var(--color-violet);
  }

  .pylopdfNav > span:last-child {
    margin-left: auto;
  }

  .pylopdfStage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(150px, 0.44fr);
    gap: 24px;
    align-items: center;
    min-height: 420px;
    padding: clamp(34px, 5.5vw, 66px);
  }

  .pylopdfHeadline {
    position: relative;
    z-index: 2;
    font-family: Georgia, serif;
    font-size: clamp(1.95rem, 3.8vw, 4rem);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.055em;
  }

  .pylopdfHeadline em {
    color: var(--color-violet);
  }

  .pdfDocument {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-height: 280px;
    padding: 30px 24px;
    overflow: hidden;
    background: var(--color-text-strong);
    box-shadow: 12px 16px 0
      color-mix(in oklab, var(--color-violet) 22%, transparent);
    transform: rotate(3deg);
  }

  .pdfFold {
    position: absolute;
    top: 0;
    right: 0;
    width: 42px;
    height: 42px;
    background: linear-gradient(
      45deg,
      color-mix(in oklab, var(--color-info) 30%, var(--color-text-strong)) 50%,
      color-mix(in oklab, var(--color-text-strong) 80%, var(--color-info)) 50%
    );
  }

  .pdfTitle {
    margin-bottom: 36px;
    font-family: var(--font-mono);
    font-size: 2.8rem;
    font-weight: 800;
    color: var(--color-violet);
  }

  .pdfLines {
    width: 100%;
    height: 7px;
    margin-bottom: 12px;
    background: color-mix(in oklab, var(--color-bg-deep) 18%, transparent);
  }

  .pdfLines.short {
    width: 68%;
  }

  .pdfCode {
    padding: 8px 10px;
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--color-text-strong);
    background: var(--color-bg-deep);
  }

  .hayateCanvas {
    background: color-mix(
      in oklab,
      var(--color-text-strong) 92%,
      var(--color-accent)
    );
  }

  .hayateBar {
    color: var(--color-bg-deep);
    background: color-mix(
      in oklab,
      var(--color-accent) 52%,
      var(--color-text-strong)
    );
  }

  .hayateBrand {
    font-size: 1rem;
    font-weight: 800;
  }

  .hayateSearch {
    padding: 6px 10px;
    margin-left: auto;
    font-weight: 500;
    border: 1px solid color-mix(in oklab, var(--color-bg-deep) 20%, transparent);
    border-radius: var(--radius-sm);
  }

  .hayateStage {
    display: grid;
    grid-template-columns: 150px 1fr;
    min-height: 420px;
  }

  .docsNav {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 32px 24px;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: color-mix(in oklab, var(--color-bg-deep) 72%, transparent);
    border-right: 1px solid
