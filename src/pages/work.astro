---
import DataSpecimens from "@/components/work/DataSpecimens.astro";
import EditorSpecimen from "@/components/work/EditorSpecimen.astro";
import PdfSpecimens from "@/components/work/PdfSpecimens.astro";
import ZumenSpecimen from "@/components/work/ZumenSpecimen.astro";
import { WORK_CATALOG } from "@/data/work-catalog";
import Base from "@/layouts/Base.astro";

const collections = [
  { id: "pdf", name: "PDF tools" },
  { id: "data", name: "Data tools" },
  { id: "editor", name: "VS Code extensions" },
] as const;

const zumen = WORK_CATALOG[0];
---

<Base
  description="Selected work by Yusuke Hayashi for CAD and BIM, PDFs, local data files, and document workflows in VS Code."
  path="/work"
  themeColor="#f9f5ec"
  title="Selected Work | Yusuke Hayashi"
>
  <main class="workMain">
    <header class="masthead">
      <p class="overline">Products &amp; open source</p>
      <div class="titleRow">
        <h1 data-view-transition-name="page-title">
          Selected <em>Work</em>
        </h1>
        <nav class="contents" aria-label="Project categories">
          <a href="#zumen">CAD &amp; BIM</a>
          {collections.map(({ id, name }) => (
            <a href={`#${id}`}>{name}</a>
          ))}
        </nav>
      </div>
    </header>

    <article class="feature" id={zumen.id} aria-labelledby="zumen-title">
      <div class="featureHeading">
        <p class="featureLabel">CAD &amp; BIM</p>
        <h2 id="zumen-title">{zumen.name}</h2>
      </div>
      <div class="featureBody">
        <p class="featureDescription">{zumen.description}</p>
        <a class="visit" href={zumen.href}>
          Visit Zumen <span aria-hidden="true">↗</span>
        </a>
      </div>
      <ZumenSpecimen />
    </article>

    {collections.map((collection) => (
      <section
        class="collection"
        id={collection.id}
        aria-labelledby={`heading-${collection.id}`}
      >
        <h2 class="sectionTitle" id={`heading-${collection.id}`}>
          {collection.name}
        </h2>
        <div
          class:list={["projects", { extensions: collection.id === "editor" }]}
        >
          {WORK_CATALOG.filter((work) => work.collection === collection.id).map(
            (work) => (
              <article class="project" id={work.id}>
                <div class="art">
                  {work.collection === "pdf" && <PdfSpecimens kind={work.id} />}
                  {work.collection === "data" && (
                    <DataSpecimens kind={work.id} />
                  )}
                  {work.collection === "editor" && (
                    <EditorSpecimen kind={work.id} />
                  )}
                </div>
                <h3>
                  <a class="projectLink" href={work.href}>
                    {work.name}
                    <span aria-hidden="true" class="outbound">
                      ↗
                    </span>
                  </a>
                </h3>
                <p class="description">{work.description}</p>
              </article>
            ),
          )}
        </div>
      </section>
    ))}

    <section aria-labelledby="work-contact-title" class="workContact">
      <p class="overline">Build with me</p>
      <h2 id="work-contact-title">
        Have a difficult workflow that should become a useful product?
      </h2>
      <div class="contactLinks">
        <a class="conversation" href="/#contact">
          Start a conversation <span aria-hidden="true">→</span>
        </a>
        <a href="https://github.com/yhay81">
          See all repositories <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>
</Base>

<style>
  :global(html:has(.workMain)) {
    --sheet: oklch(97.1% 0.012 86deg);

    color-scheme: light;
    background: var(--sheet);
  }

  :global(body:has(.workMain)) {
    --ink: oklch(22% 0.017 257deg);
    --graphite: oklch(39.5% 0.014 254deg);
    --rule: oklch(81% 0.014 80deg);
    --rust: oklch(49% 0.154 40deg);
    --color-text: var(--graphite);
    --color-text-strong: var(--ink);
    --color-text-soft: var(--graphite);
    --color-accent: var(--rust);
    --border-subtle: var(--rule);
    --scrim: color-mix(in oklab, var(--sheet) 94%, transparent);
    --surface-raised: color-mix(in oklab, var(--ink) 7%, var(--sheet));

    background: var(--sheet);
  }

  .workMain {
    max-width: 1550px;
    min-height: auto;
    padding-top: var(--nav-height);
    padding-bottom: clamp(36px, 6vw, 96px);
  }

  .masthead {
    padding: clamp(40px, 5vw, 76px) 0 clamp(24px, 3vw, 44px);
  }

  .overline,
  .featureLabel {
    display: flex;
    gap: 10px;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .overline::before {
    width: 25px;
    height: 2px;
    background: var(--rust);
    content: "";
  }

  .titleRow {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 40px;
    align-items: flex-end;
    justify-content: space-between;
    margin-top: 14px;
  }

  h1 {
    font-size: clamp(3.1rem, 7.9vw, 7.45rem);
    font-weight: 550;
    line-height: 1;
    letter-spacing: -0.077em;
  }

  h1 em {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 400;
    color: var(--rust);
    letter-spacing: -0.075em;
  }

  .contents {
    display: grid;
    grid-template-columns: auto auto;
    gap: 2px 22px;
    margin-bottom: 5px;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
  }

  .contents a {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 3px 0;
  }

  .contents a::before {
    color: var(--rust);
    content: "↘";
  }

  .feature,
  .project {
    scroll-margin-top: calc(var(--nav-height) + 20px);
  }

  .feature {
    --board: oklch(26% 0.046 255deg);
    --chalk: oklch(96.2% 0.014 81deg);

    display: grid;
    grid-template:
      ". drawing" minmax(28px, 1fr)
      "heading drawing" auto
      "summary drawing" auto
      ". drawing" minmax(28px, 1fr) / 0.78fr 1.22fr;
    overflow: hidden;
    color: var(--chalk);
    background: var(--board);
    border-radius: 4px;
  }

  .featureHeading,
  .featureBody {
    padding-inline: clamp(28px, 3.9vw, 68px);
  }

  .featureHeading {
    grid-area: heading;
  }

  .featureBody {
    grid-area: summary;
  }

  .featureLabel {
    color: oklch(85% 0.095 71deg);
  }

  .feature h2 {
    margin: 12px 0 17px;
    font-size: clamp(3rem, 5vw, 5rem);
    font-weight: 550;
    line-height: 1;
    color: var(--chalk);
    letter-spacing: -0.065em;
  }

  .featureDescription {
    max-width: 38ch;
    font-size: var(--text-base);
    line-height: 1.55;
    color: oklch(87% 0.019 248deg);
  }

  .visit,
  .conversation {
    display: inline-flex;
    gap: 16px;
    align-items: center;
    padding: 9px 16px;
    font-size: var(--text-sm);
    font-weight: 650;
    border: 1px solid transparent;
    border-radius: 3px;
  }

  .visit {
    margin-top: 26px;
    color: var(--board);
    background: var(--chalk);

    &:hover,
    &:focus-visible {
      color: var(--board);
      background: oklch(89% 0.09 78deg);
    }
  }

  .collection {
    max-width: none;
    padding: clamp(52px, 6vw, 88px) 0 0;
    scroll-margin-top: var(--nav-height);
  }

  .sectionTitle {
    display: flex;
    gap: clamp(20px, 3vw, 44px);
    align-items: center;
    margin-bottom: clamp(18px, 2vw, 28px);
    font-size: clamp(1.8rem, 3.1vw, 3rem);
    font-weight: 550;
    letter-spacing: -0.055em;
  }

  .sectionTitle::after {
    flex: 1;
    height: 1px;
    background: var(--rule);
    content: "";
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 34px clamp(20px, 3vw, 46px);
  }

  .extensions {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .project {
    position: relative;
    min-width: 0;
  }

  .art {
    overflow: hidden;
    border-radius: 3px;
  }

  .project h3 {
    margin: 17px 0 9px;
    font-size: clamp(1.6rem, 2.8vw, 2.8rem);
    line-height: 1.13;
    letter-spacing: -0.055em;
  }

  .extensions h3 {
    font-size: clamp(1.25rem, 2.2vw, 2rem);
  }

  .projectLink {
    position: static;
    display: flex;
    gap: 14px;
    align-items: baseline;
    justify-content: space-between;
  }

  .projectLink::before {
    position: absolute;
    inset: 0;
    content: "";
  }

  .projectLink:focus-visible {
    outline: none;
  }

  .projectLink:focus-visible::before {
    outline: 2px solid var(--rust);
    outline-offset: 5px;
  }

  .outbound {
    display: inline-grid;
    flex: none;
    align-self: center;
    width: 32px;
    height: 32px;
    place-content: center;
    font-family: var(--font-sans);
    font-size: 0.97rem;
    font-weight: 500;
    letter-spacing: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
  }

  .projectLink:is(:hover, :focus-visible) .outbound {
    color: var(--sheet);
    background: var(--rust);
    border-color: var(--rust);
  }

  .description {
    max-width: 58ch;
    line-height: 1.6;
    color: var(--graphite);
  }

  .workContact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 16px 30px;
    align-items: end;
    max-width: none;
    padding: clamp(32px, 4.5vw, 64px) 0;
    margin-top: clamp(68px, 8vw, 120px);
    border-block: 1px solid var(--rule);
  }

  .workContact .overline {
    grid-column: 1 / -1;
  }

  .workContact h2 {
    max-width: 24ch;
    font-size: clamp(1.8rem, 3.2vw, 3.3rem);
    font-weight: 550;
    letter-spacing: -0.055em;
  }

  .contactLinks {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    align-items: center;
    font-size: var(--text-sm);
  }

  .conversation {
    color: var(--sheet);
    background: var(--ink);

    &:hover,
    &:focus-visible {
      color: var(--sheet);
      background: var(--rust);
    }
  }

  @media (width <= 920px) {
    .workMain {
      padding-right: max(var(--page-padding), 64px);
    }

    .workContact {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .feature {
      grid-template-columns: 0.88fr 1.12fr;
    }
  }

  @media (width <= 768px) {
    .workMain {
      padding-inline: clamp(20px, 5vw, 36px);
    }

    .feature {
      grid-template: "heading" auto "drawing" auto "summary" auto / 1fr;
    }

    .featureHeading {
      display: flex;
      flex-direction: row-reverse;
      align-items: center;
      justify-content: space-between;
      padding: 15px 22px;
    }

    .feature h2 {
      margin: 0;
      font-size: 2.3rem;
    }

    .featureBody {
      padding: 22px;
    }

    .visit {
      margin-top: 16px;
    }

    .featureDescription {
      max-width: 58ch;
    }
  }

  @media (width <= 640px) {
    .contents {
      display: flex;
      flex-wrap: wrap;
      gap: 0 15px;
      margin: 0;
    }

    .contents a::before {
      display: none;
    }

    .contents a {
      padding: 6px 0;
      text-decoration: underline;
      text-decoration-color: var(--rule);
      text-underline-offset: 4px;
    }

    .projects {
      grid-template-columns: 1fr;
    }

    .extensions h3 {
      font-size: var(--text-xl);
    }
  }
</style>
