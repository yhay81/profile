---
import "@/styles/article.css";

import CodeBlock from "@/components/CodeBlock.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import TrustGraph from "@/components/TrustGraph.astro";
import Base from "@/layouts/Base.astro";
import {
  ENS_NAME,
  ETH_ADDRESS,
  IPFS_IDENTITY_GATEWAY,
  KEYOXIDE_URL,
  PROFILE_NAME,
} from "@/lib/site";

const title = `Verifiable Identity | ${PROFILE_NAME}`;
const description =
  "How a Sigstore-attested release binds my public identifiers and how to verify it independently.";

interface ProofCard {
  pair: string;
  method: string;
  href: string;
  linkText: string;
  external: boolean;
}

const PROOF_CARDS: ProofCard[] = [
  {
    pair: "GitHub ⇄ PGP",
    method: "Keyoxide proof (gist) + every commit signed",
    href: KEYOXIDE_URL,
    linkText: "keyoxide.org",
    external: true,
  },
  {
    pair: "Domains ⇄ PGP",
    method: "DNS TXT records (openpgp4fpr) on both domains",
    href: KEYOXIDE_URL,
    linkText: "verify via Keyoxide",
    external: true,
  },
  {
    pair: "Email ⇄ PGP",
    method: "WKD on haya.company + verified on keys.openpgp.org",
    href: "/keys",
    linkText: "key policy",
    external: false,
  },
  {
    pair: "PGP ⇄ Ethereum",
    method: "Bidirectional offline signatures (clearsign + EIP-191)",
    href: "/proofs",
    linkText: "cross-attestation",
    external: false,
  },
  {
    pair: "ENS ⇄ Ethereum",
    method:
      "On-chain forward + primary reverse resolution with monitored profile records",
    href: `https://app.ens.domains/${ENS_NAME}`,
    linkText: ENS_NAME,
    external: true,
  },
  {
    pair: "ENS ⇄ IPFS",
    method:
      "On-chain contenthash naming an immutable identity capsule and avatar",
    href: IPFS_IDENTITY_GATEWAY,
    linkText: "open IPFS capsule",
    external: true,
  },
  {
    pair: "This site ⇄ me",
    method: "PGP-signed security.txt, timestamped on Bitcoin (OTS)",
    href: "/.well-known/security.txt",
    linkText: "security.txt",
    external: false,
  },
  {
    pair: "Nostr ⇄ this domain",
    method: "NIP-05 mapping served from .well-known",
    href: "/.well-known/nostr.json",
    linkText: "nostr.json",
    external: false,
  },
  {
    pair: "Canonical identity state",
    method:
      "Sigstore-attested manifest with compatibility signature, hashed audit history, and pinned verifier",
    href: "/.well-known/identity.json",
    linkText: "identity.json",
    external: false,
  },
  {
    pair: "Deployment ⇄ source",
    method:
      "Sigstore/SLSA attestations over the identity manifest, deterministic release archive, and deployment archive",
    href: "/integrity",
    linkText: "release integrity",
    external: false,
  },
];

const VERIFY_QUICKSTART = `# 1. Fetch my key via WKD and check the Keyoxide proofs
gpg --locate-keys yusuke@haya.company
open ${KEYOXIDE_URL}

# 2. Verify the PGP ⇄ Ethereum cross-attestation
curl -sO https://yusuke-hayashi.com/proofs/statement.txt.asc
gpg --verify statement.txt.asc
cast wallet verify --address ${ETH_ADDRESS} "<message>" "<signature>"

# 3. Verify ENS forward and primary reverse resolution
cast resolve-name ${ENS_NAME}
cast lookup-address ${ETH_ADDRESS}`;

const VERIFY_BOOTSTRAP = `# Pin the accepted release authority before trusting site content
OIDC_ISSUER=https://token.actions.githubusercontent.com
REPOSITORY=yhay81/profile
WORKFLOW=.github/workflows/cloudflare.yml
SOURCE_REF=refs/heads/main

# Independently obtain this compatibility fingerprint, then compare it locally
EXPECTED_FINGERPRINT=B22B98ABB2D503307AB6A3160718EFA6506BB669
gpg --locate-keys yusuke@haya.company
ACTUAL_FINGERPRINT="$(gpg --with-colons --fingerprint yusuke@haya.company \\
  | awk -F: '$1 == "fpr" { print $10; exit }')"
test "$ACTUAL_FINGERPRINT" = "$EXPECTED_FINGERPRINT"`;

const VERIFY_MACHINE = `# Download the current manifest and deployed source commit
curl -sO https://yusuke-hayashi.com/.well-known/release.json
curl -sO https://yusuke-hayashi.com/.well-known/identity.json
SOURCE_COMMIT="$(node -p 'JSON.parse(require("fs").readFileSync("release.json")).source.commit')"

# Verify the OpenPGP compatibility signature
gpg --locate-keys yusuke@haya.company
curl -sO https://yusuke-hayashi.com/.well-known/identity.json.asc
gpg --verify identity.json.asc identity.json

# Verify GitHub Actions / Sigstore provenance against the deployed commit
gh attestation verify identity.json \\
  --repo yhay81/profile \\
  --signer-workflow yhay81/profile/.github/workflows/cloudflare.yml \\
  --cert-oidc-issuer https://token.actions.githubusercontent.com \\
  --source-ref refs/heads/main \\
  --source-digest "$SOURCE_COMMIT" \\
  --predicate-type https://slsa.dev/provenance/v1 \\
  --deny-self-hosted-runners

# Verify the downloaded CLI hash before executing it (Node.js 22+)
curl -sO https://yusuke-hayashi.com/.well-known/verify-identity.mjs
EXPECTED_SHA256="$(node -p 'JSON.parse(require("fs").readFileSync("identity.json")).verifier.sha256')"
ACTUAL_SHA256="$(shasum -a 256 verify-identity.mjs | awk '{ print $1 }')"
test "$ACTUAL_SHA256" = "$EXPECTED_SHA256"
node verify-identity.mjs`;
---

<Base description={description} path="/identity" title={title}>
  <main>
    <section>
      <SectionHeader label="Identity" no="00" title="Verifiable Identity" />

      <p class="lead">
        Anyone can claim a name. This page shows the cryptographic links — DNS
        records, signed statements, and key notations — that let you verify this
        site, my code, and my on-chain account all belong to the same person.
      </p>

      <TrustGraph />

      <h2 class="heading">The proofs</h2>

      <div class="cards">
        {
          PROOF_CARDS.map((card) => (
            <article class="card reveal">
              <h3 class="cardPair">{card.pair}</h3>
              <p class="cardMethod">{card.method}</p>
              <a
                class="cardLink"
                href={card.href}
                rel={card.external ? "noreferrer" : undefined}
                target={card.external ? "_blank" : undefined}
              >
                {card.linkText} ↗
              </a>
            </article>
          ))
        }
      </div>

      <h2 class="heading">Humanity status</h2>

      <aside
        class="humanityStatus reveal"
        aria-labelledby="humanity-status-title"
      >
        <div class="statusHeading">
          <h3 id="humanity-status-title">Awaiting an independent witness</h3>
          <span class="statusBadge">0 active records</span>
        </div>
        <p>
          The verification framework is live, but no one has issued a humanity
          attestation for me yet. It requires an in-person observation, a fresh
          challenge signed by this identity address, and a separate signature
          from the witness. It proves that limited event—not global uniqueness,
          legal identity, reputation, or human authorship.
        </p>
        <p>
          I have not published a Human Passport score on its supported chains,
          so I do not present one here as public evidence.
        </p>
        <div class="statusLinks">
          <a href="/.well-known/attestations/index.json">public registry ↗</a>
          <a href="/.well-known/attestations/policy.json"
            >verification policy ↗</a
          >
        </div>
      </aside>

      <h2 class="heading">Verify it yourself</h2>

      <p class="bodyText">
        Start from the pinned release policy: OIDC issuer, repository, workflow,
        source ref, and source commit. Then verify the OpenPGP compatibility
        fingerprint through an independently obtained channel. No site can
        establish trust merely by serving its own key and verifier.
      </p>

      <CodeBlock
        code={VERIFY_BOOTSTRAP}
        label="Pin the release authority"
        language="bash"
        wrap
      />

      <p class="bodyText">
        Once those independent inputs are pinned, the remaining checks take
        about two minutes. Details live on{" "}
        <a href="/keys">/keys</a> and <a href="/proofs">/proofs</a>; the{" "}
        <a href="/siwe">SIWE demo</a> shows the same Ethereum signature scheme working
        live in your browser.
      </p>

      <CodeBlock
        code={VERIFY_QUICKSTART}
        label="Two-minute verification"
        language="bash"
        wrap
      />

      <h2 class="heading">Machine-readable identity</h2>

      <p class="bodyText">
        The signed <a href="/.well-known/identity.json">identity manifest</a>{
          " "
        }
        pins every public identifier, the hash of its{" "}
        <a href="/.well-known/identity-history.json">append-only history</a>,
        and the exact verifier bundle. A scheduled health check uses the same
        verifier to detect broken signatures, DNS/ENS drift, and expired proofs.
        GitHub Actions also packages the manifest, schemas, policy, verifier,
        keys, and history into a deterministic identity release and attests both
        the manifest and archive with Sigstore/SLSA. The{" "}
        <a href="/integrity">release ledger</a> separately binds every deployed byte
        to its source commit.
      </p>

      <CodeBlock
        code={VERIFY_MACHINE}
        label="Machine verification"
        language="bash"
        wrap
      />

      <h2 class="heading">Design notes</h2>

      <p class="bodyText">
        The current release policy, trust-bootstrap rules, recovery boundary,
        and AI delegation policy are described in{" "}
        <a href="/trust-control-plane">A Personal Trust Control Plane</a>{" "}
        (clearsigned).
      </p>

      <p class="updated">
        <a href={`https://app.ens.domains/${ENS_NAME}`}>{ENS_NAME}</a> resolves to
        this identity account in both directions. Its contenthash names an{" "}
        <a href={IPFS_IDENTITY_GATEWAY} rel="noreferrer" target="_blank">
          immutable IPFS capsule
        </a>, while the signed HTTPS manifest remains the current revocation and
        monitoring surface. ENS remains an optional naming adapter rather than
        the root of trust.
      </p>
    </section>
  </main>
</Base>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 12px;
    margin-top: 8px;
  }

  .card {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 16px 18px;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: inset 0 1px 0 var(--surface-raised);
  }

  .cardPair {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }

  .cardMethod {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text);
  }

  .cardLink {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-strong);

    &:hover,
    &:focus-visible {
      color: var(--color-accent);
    }
  }

  .humanityStatus {
    display: grid;
    gap: 12px;
    padding: 20px;
    background: var(--surface-card);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    box-shadow: inset 0 1px 0 var(--surface-raised);

    p {
      margin: 0;
      font-size: var(--text-sm);
      line-height: 1.7;
      color: var(--color-text);
    }
  }

  .statusHeading {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
    align-items: center;
    justify-content: space-between;

    h3 {
      margin: 0;
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      color: var(--color-text-strong);
      letter-spacing: 0.03em;
    }
  }

  .statusBadge {
    padding: 4px 8px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    border: 1px solid color-mix(in oklab, var(--color-accent) 45%, transparent);
    border-radius: 999px;
  }

  .statusLinks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;

    a {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--color-text-strong);

      &:hover,
      &:focus-visible {
        color: var(--color-accent);
      }
    }
  }
</style>
