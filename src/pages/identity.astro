---
import "@/styles/article.css";

import CodeBlock from "@/components/CodeBlock.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import TrustGraph from "@/components/TrustGraph.astro";
import Base from "@/layouts/Base.astro";
import { ENS_NAME, ETH_ADDRESS, KEYOXIDE_URL, PROFILE_NAME } from "@/lib/site";

const title = `Verifiable Identity | ${PROFILE_NAME}`;
const description =
  "How my GitHub, domains, email, OpenPGP key, and Ethereum account are cryptographically linked — and how to verify it yourself.";

interface ProofCard {
  pair: string;
  method: string;
  href: string;
  linkText: string;
  external: boolean;
}

const PROOF_CARDS: ProofCard[] = [
  {
    pair: "GitHub ⇄ PGP",
    method: "Keyoxide proof (gist) + every commit signed",
    href: KEYOXIDE_URL,
    linkText: "keyoxide.org",
    external: true,
  },
  {
    pair: "Domains ⇄ PGP",
    method: "DNS TXT records (openpgp4fpr) on both domains",
    href: KEYOXIDE_URL,
    linkText: "verify via Keyoxide",
    external: true,
  },
  {
    pair: "Email ⇄ PGP",
    method: "WKD on haya.company + verified on keys.openpgp.org",
    href: "/keys",
    linkText: "key policy",
    external: false,
  },
  {
    pair: "PGP ⇄ Ethereum",
    method: "Bidirectional offline signatures (clearsign + EIP-191)",
    href: "/proofs",
    linkText: "cross-attestation",
    external: false,
  },
  {
    pair: "ENS ⇄ Ethereum",
    method:
      "On-chain forward + primary reverse resolution with monitored text records",
    href: `https://app.ens.domains/${ENS_NAME}`,
    linkText: ENS_NAME,
    external: true,
  },
  {
    pair: "This site ⇄ me",
    method: "PGP-signed security.txt, timestamped on Bitcoin (OTS)",
    href: "/.well-known/security.txt",
    linkText: "security.txt",
    external: false,
  },
  {
    pair: "Nostr ⇄ this domain",
    method: "NIP-05 mapping served from .well-known",
    href: "/.well-known/nostr.json",
    linkText: "nostr.json",
    external: false,
  },
  {
    pair: "Machine-readable root",
    method: "OpenPGP-signed identity manifest with hashed history and verifier",
    href: "/.well-known/identity.json",
    linkText: "identity.json",
    external: false,
  },
  {
    pair: "Deployment ⇄ source",
    method:
      "Per-file release digest, reproducible build provenance, and budgets",
    href: "/integrity",
    linkText: "release integrity",
    external: false,
  },
];

const VERIFY_QUICKSTART = `# 1. Fetch my key via WKD and check the Keyoxide proofs
gpg --locate-keys yusuke@haya.company
open ${KEYOXIDE_URL}

# 2. Verify the PGP ⇄ Ethereum cross-attestation
curl -sO https://yusuke-hayashi.com/proofs/statement.txt.asc
gpg --verify statement.txt.asc
cast wallet verify --address ${ETH_ADDRESS} "<message>" "<signature>"

# 3. Verify ENS forward and primary reverse resolution
cast resolve-name ${ENS_NAME}
cast lookup-address ${ETH_ADDRESS}`;

const VERIFY_BOOTSTRAP = `# Obtain this fingerprint out of band, then compare it locally
EXPECTED_FINGERPRINT=B22B98ABB2D503307AB6A3160718EFA6506BB669
gpg --locate-keys yusuke@haya.company
ACTUAL_FINGERPRINT="$(gpg --with-colons --fingerprint yusuke@haya.company \\
  | awk -F: '$1 == "fpr" { print $10; exit }')"
test "$ACTUAL_FINGERPRINT" = "$EXPECTED_FINGERPRINT"`;

const VERIFY_MACHINE = `# Verify the machine-readable identity root via WKD
gpg --locate-keys yusuke@haya.company
curl -sO https://yusuke-hayashi.com/.well-known/identity.json
curl -sO https://yusuke-hayashi.com/.well-known/identity.json.asc
gpg --verify identity.json.asc identity.json

# Verify the downloaded CLI hash before executing it (Node.js 22+)
curl -sO https://yusuke-hayashi.com/.well-known/verify-identity.mjs
EXPECTED_SHA256="$(node -p 'JSON.parse(require("fs").readFileSync("identity.json")).verifier.sha256')"
ACTUAL_SHA256="$(shasum -a 256 verify-identity.mjs | awk '{ print $1 }')"
test "$ACTUAL_SHA256" = "$EXPECTED_SHA256"
node verify-identity.mjs`;
---

<Base description={description} path="/identity" title={title}>
  <main>
    <section>
      <SectionHeader label="Identity" no="00" title="Verifiable Identity" />

      <p class="lead">
        Anyone can claim a name. This page shows the cryptographic links — DNS
        records, signed statements, and key notations — that let you verify this
        site, my code, and my on-chain account all belong to the same person.
      </p>

      <TrustGraph />

      <h2 class="heading">The proofs</h2>

      <div class="cards">
        {
          PROOF_CARDS.map((card) => (
            <article class="card reveal">
              <h3 class="cardPair">{card.pair}</h3>
              <p class="cardMethod">{card.method}</p>
              <a
                class="cardLink"
                href={card.href}
                rel={card.external ? "noreferrer" : undefined}
                target={card.external ? "_blank" : undefined}
              >
                {card.linkText} ↗
              </a>
            </article>
          ))
        }
      </div>

      <h2 class="heading">Humanity status</h2>

      <aside
        class="humanityStatus reveal"
        aria-labelledby="humanity-status-title"
      >
        <div class="statusHeading">
          <h3 id="humanity-status-title">Awaiting an independent witness</h3>
          <span class="statusBadge">0 active records</span>
        </div>
        <p>
          The verification framework is live, but no one has issued a humanity
          attestation for me yet. It requires an in-person observation, a fresh
          challenge signed by this identity address, and a separate signature
          from the witness. It proves that limited event—not global uniqueness,
          legal identity, reputation, or human authorship.
        </p>
        <p>
          I have also not published a Human Passport score on any of its seven
          supported chains as checked on 2026-07-17, so I do not present it here
          as public evidence.
        </p>
        <div class="statusLinks">
          <a href="/.well-known/attestations/index.json">public registry ↗</a>
          <a href="/.well-known/attestations/policy.json"
            >verification policy ↗</a
          >
        </div>
      </aside>

      <h2 class="heading">Verify it yourself</h2>

      <p class="bodyText">
        Start from an OpenPGP fingerprint obtained through a channel you already
        trust. No site can establish trust in itself merely by serving its own
        key and verifier. Compare the fingerprint through an in-person exchange,
        a previously signed document, or multiple separately controlled routes
        such as WKD, DNS, and the signed GitHub history.
      </p>

      <CodeBlock code={VERIFY_BOOTSTRAP} />

      <p class="bodyText">
        Once that root is pinned, the remaining checks take about two minutes.
        Details live on{" "}
        <a href="/keys">/keys</a> and <a href="/proofs">/proofs</a>; the{" "}
        <a href="/siwe">SIWE demo</a> shows the same Ethereum signature scheme working
        live in your browser.
      </p>

      <CodeBlock code={VERIFY_QUICKSTART} />

      <h2 class="heading">Machine-readable identity</h2>

      <p class="bodyText">
        The signed <a href="/.well-known/identity.json">identity manifest</a>{
          " "
        }
        pins every public identifier, the hash of its{" "}
        <a href="/.well-known/identity-history.json">append-only history</a>,
        and the exact verifier bundle. A scheduled health check uses the same
        verifier to detect broken signatures, DNS/ENS drift, and expired proofs.
        The{" "}
        <a href="/integrity">release ledger</a> separately binds every deployed byte
        to its source commit.
      </p>

      <CodeBlock code={VERIFY_MACHINE} />

      <p class="updated">
        <a href={`https://app.ens.domains/${ENS_NAME}`}>{ENS_NAME}</a> resolves to
        this identity account in both directions. ENS remains an optional naming adapter
        rather than the root of trust.
      </p>
    </section>
  </main>
</Base>

<style>
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 12px;
    margin-top: 8px;
  }

  .card {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 16px 18px;
    background: linear-gradient(
      170deg,
      var(--surface-raised),
      color-mix(in oklab, var(--color-bg-deep) 22%, transparent) 65%,
      color-mix(in oklab, var(--color-accent) 4%, transparent)
    );
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .cardPair {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }

  .cardMethod {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text);
  }

  .cardLink {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-strong);

    &:hover,
    &:focus-visible {
      color: var(--color-accent);
    }
  }

  .humanityStatus {
    display: grid;
    gap: 12px;
    padding: 20px;
    background: color-mix(in oklab, var(--surface-raised) 92%, transparent);
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--color-accent);
    border-radius: var(--radius-md);

    p {
      margin: 0;
      font-size: var(--text-sm);
      line-height: 1.7;
      color: var(--color-text);
    }
  }

  .statusHeading {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
    align-items: center;
    justify-content: space-between;

    h3 {
      margin: 0;
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      color: var(--color-text-strong);
      letter-spacing: 0.03em;
    }
  }

  .statusBadge {
    padding: 4px 8px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    border: 1px solid color-mix(in oklab, var(--color-accent) 45%, transparent);
    border-radius: 999px;
  }

  .statusLinks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;

    a {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--color-text-strong);

      &:hover,
      &:focus-visible {
        color: var(--color-accent);
      }
    }
  }
</style>
