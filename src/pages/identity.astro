---
import "@/styles/article.css";

import CodeBlock from "@/components/CodeBlock.astro";
import ReleaseIntegrity from "@/components/ReleaseIntegrity.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import TrustGraph from "@/components/TrustGraph.astro";
import Base from "@/layouts/Base.astro";
import {
  ENS_NAME,
  IPFS_IDENTITY_GATEWAY,
  KEYOXIDE_URL,
  PROFILE_NAME,
} from "@/lib/site";

const title = `Identity & Release Integrity | ${PROFILE_NAME}`;
const description =
  "How my public identifiers and this site's deployed bytes are bound to verifiable evidence.";

interface ProofCard {
  pair: string;
  method: string;
  href: string;
  linkText: string;
  external: boolean;
}

const PROOF_CARDS: ProofCard[] = [
  {
    pair: "GitHub ⇄ PGP",
    method: "Keyoxide gist proof + enforced main-branch rules",
    href: KEYOXIDE_URL,
    linkText: "keyoxide.org",
    external: true,
  },
  {
    pair: "Domains ⇄ PGP",
    method:
      "DNS TXT records (openpgp4fpr) on yusuke-hayashi.com and haya-inc.co.jp",
    href: KEYOXIDE_URL,
    linkText: "keyoxide.org",
    external: true,
  },
  {
    pair: "Email ⇄ PGP",
    method: "WKD on haya.company + verified on keys.openpgp.org",
    href: "/keys",
    linkText: "key policy",
    external: false,
  },
  {
    pair: "PGP ⇄ Ethereum",
    method: "Bidirectional offline signatures (clearsign + EIP-191)",
    href: "/proofs",
    linkText: "cross-attestation",
    external: false,
  },
  {
    pair: "ENS ⇄ Ethereum",
    method:
      "On-chain forward + primary reverse resolution with monitored profile records",
    href: `https://app.ens.domains/${ENS_NAME}`,
    linkText: ENS_NAME,
    external: true,
  },
  {
    pair: "ENS ⇄ IPFS",
    method:
      "On-chain contenthash naming an immutable identity capsule and avatar",
    href: IPFS_IDENTITY_GATEWAY,
    linkText: "open IPFS capsule",
    external: true,
  },
  {
    pair: "This site ⇄ me",
    method: "PGP-signed security.txt, timestamped on Bitcoin (OTS)",
    href: "/.well-known/security.txt",
    linkText: "security.txt",
    external: false,
  },
  {
    pair: "Nostr · Bluesky ⇄ domain",
    method: "NIP-05 (.well-known) + AT Protocol DID (_atproto DNS TXT)",
    href: "/.well-known/nostr.json",
    linkText: "nostr.json",
    external: false,
  },
  {
    pair: "Canonical identity state",
    method:
      "Sigstore-attested manifest with compatibility signature, hashed audit history, and pinned verifier",
    href: "/.well-known/identity.json",
    linkText: "identity.json",
    external: false,
  },
  {
    pair: "Deployment ⇄ source",
    method:
      "Sigstore/SLSA attestations over the identity manifest, deterministic release archive, and deployment archive",
    href: "#release-integrity",
    linkText: "release integrity",
    external: false,
  },
];

const VERIFY_IDENTITY = `# 1. Compare the OpenPGP compatibility key against an out-of-band fingerprint
EXPECTED_FINGERPRINT=B22B98ABB2D503307AB6A3160718EFA6506BB669
gpg --locate-keys yusuke@haya.company
ACTUAL_FINGERPRINT="$(gpg --with-colons --fingerprint yusuke@haya.company \\
  | awk -F: '$1 == "fpr" { print $10; exit }')"
test "$ACTUAL_FINGERPRINT" = "$EXPECTED_FINGERPRINT"

# 2. Fetch the deployed commit and compare it with current main on GitHub
curl -fsSLO https://yusuke-hayashi.com/.well-known/release.json
curl -fsSLO https://yusuke-hayashi.com/.well-known/identity.json
curl -fsSLO https://yusuke-hayashi.com/.well-known/identity.json.asc
SOURCE_COMMIT="$(node -p 'JSON.parse(require("node:fs").readFileSync("release.json", "utf8")).source.commit')"
MAIN_COMMIT="$(gh api repos/yhay81/profile/commits/main --jq .sha)"
echo "deployed: $SOURCE_COMMIT | main: $MAIN_COMMIT"

# 3. Verify OpenPGP compatibility signature and Sigstore/SLSA provenance
gpg --verify identity.json.asc identity.json
gh attestation verify identity.json \\
  --repo yhay81/profile \\
  --signer-workflow yhay81/profile/.github/workflows/cloudflare.yml \\
  --cert-oidc-issuer https://token.actions.githubusercontent.com \\
  --source-ref refs/heads/main \\
  --source-digest "$SOURCE_COMMIT" \\
  --predicate-type https://slsa.dev/provenance/v1 \\
  --deny-self-hosted-runners

# 4. Verify the CLI hash against the attested manifest before executing it
curl -fsSLO https://yusuke-hayashi.com/.well-known/verify-identity.mjs
node -e '
  const crypto = require("node:crypto"), fs = require("node:fs");
  const expected = JSON.parse(fs.readFileSync("identity.json", "utf8")).verifier.sha256;
  const actual = crypto.createHash("sha256").update(fs.readFileSync("verify-identity.mjs")).digest("hex");
  if (actual !== expected) process.exit(1);
'
node verify-identity.mjs`;
---

<Base description={description} path="/identity" title={title}>
  <main>
    <section>
      <SectionHeader
        label="Identity & integrity"
        no="00"
        title="Verifiable Identity"
        transitionName="page-title"
      />

      <p class="lead">
        Anyone can claim a name. This page shows the cryptographic links — DNS
        records, signed statements, and key notations — that let you verify this
        site, my code, and my on-chain account all belong to the same person,
        then binds the deployed bytes back to their source.
      </p>

      <nav aria-label="On this page" class="pageNav">
        <a href="#identity-proofs">Identity proofs</a>
        <a href="#humanity-status">Humanity status</a>
        <a href="#release-integrity">Release integrity</a>
        <a href="#verify-it-yourself">Verify it yourself</a>
        <a href="#design-notes">Design notes</a>
      </nav>

      <TrustGraph />

      <h2 class="heading" id="identity-proofs">
        The proofs
      </h2>

      <div class="cards">
        {PROOF_CARDS.map((card) => (
          <article class="card reveal">
            <h3 class="cardPair">{card.pair}</h3>
            <p class="cardMethod">{card.method}</p>
            <a
              class="cardLink"
              href={card.href}
              rel={card.external ? "noreferrer" : undefined}
              target={card.external ? "_blank" : undefined}
            >
              {card.linkText} {card.external ? "↗" : "→"}
            </a>
          </article>
        ))}
      </div>

      <h2 class="heading" id="humanity-status">
        Humanity status
      </h2>

      <aside
        class="humanityStatus reveal"
        aria-labelledby="humanity-status-title"
      >
        <div class="statusHeading">
          <h3 id="humanity-status-title">Awaiting an independent witness</h3>
          <span class="statusBadge">0 active records</span>
        </div>
        <p>
          The verification framework is live, but no one has issued a humanity
          attestation for me yet. It requires an in-person observation, a fresh
          challenge signed by this identity address, and a separate signature
          from the witness. It proves that limited event—not global uniqueness,
          legal identity, reputation, or human authorship.
        </p>
        <p>
          I have not published a Human Passport score on its supported chains,
          so I do not present one here as public evidence.
        </p>
        <div class="statusLinks">
          <a href="/.well-known/attestations/index.json">public registry ↗</a>
          <a href="/.well-known/attestations/policy.json">
            verification policy ↗
          </a>
        </div>
      </aside>

      <ReleaseIntegrity />

      <h2 class="heading" id="verify-it-yourself">
        Verify it yourself
      </h2>

      <p class="bodyText">
        No site can establish trust merely by serving its own key and verifier.
        Compare the OpenPGP compatibility fingerprint through an independent
        channel, check the deployed commit against GitHub, and verify Sigstore
        provenance before running the hash-pinned CLI.
      </p>

      <CodeBlock
        code={VERIFY_IDENTITY}
        label="Bootstrap & verify (Node.js 22+, gh, gpg)"
        language="bash"
        wrap
      />

      <p class="bodyText">
        The <a href="/.well-known/identity.json">identity manifest</a> pins
        every public identifier, its{" "}
        <a href="/.well-known/identity-history.json">append-only history</a>,
        and the verifier bundle; a scheduled health check runs the same checks
        against DNS, WKD, ENS, and proof expiry. Standalone walkthroughs live on{" "}
        <a href="/keys">/keys</a>, <a href="/proofs">/proofs</a>, and the{" "}
        <a href="/siwe">SIWE demo</a>.
      </p>

      <h2 class="heading" id="design-notes">
        Design notes
      </h2>

      <p class="bodyText">
        Routine releases are attested with GitHub Actions OIDC and Sigstore; the
        manifest currently uses the OpenPGP compatibility root (schema v4) while
        the separate 2-of-3 hardware authority root remains unconfigured. The
        release policy, recovery boundary, and AI delegation rules are described
        in <a href="/trust-control-plane">A Personal Trust Control Plane</a>{" "}
        (clearsigned).
      </p>

      <p class="updated">
        <a
          href={`https://app.ens.domains/${ENS_NAME}`}
          rel="noreferrer"
          target="_blank"
        >
          {ENS_NAME}
        </a>{" "}
        resolves to this identity account in both directions. Its contenthash
        names an{" "}
        <a href={IPFS_IDENTITY_GATEWAY} rel="noreferrer" target="_blank">
          immutable IPFS capsule
        </a>
        , while the signed HTTPS manifest remains the current revocation and
        monitoring surface. ENS remains an optional naming adapter rather than
        the root of trust.
      </p>
    </section>
  </main>
</Base>

<style>
  .pageNav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-block: 14px;
    margin-top: 28px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    border-block: 1px solid var(--border-subtle);

    a {
      color: var(--color-text-strong);

      &::before {
        color: var(--color-accent);
        content: "↳ ";
      }

      &:hover,
      &:focus-visible {
        color: var(--color-accent);
      }
    }
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 12px;
    margin-top: 8px;
  }

  .card {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 16px 18px;
    background: var(--surface-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    box-shadow: inset 0 1px 0 var(--surface-raised);
  }

  .cardPair {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    letter-spacing: 0.04em;
  }

  .cardMethod {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text);
  }

  .cardLink {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-strong);

    &:hover,
    &:focus-visible {
      color: var(--color-accent);
    }
  }

  .humanityStatus {
    display: grid;
    gap: 12px;
    padding: 20px;
    background: var(--surface-card);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-md);
    box-shadow: inset 0 1px 0 var(--surface-raised);

    p {
      margin: 0;
      font-size: var(--text-sm);
      line-height: 1.7;
      color: var(--color-text);
    }
  }

  .statusHeading {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 16px;
    align-items: center;
    justify-content: space-between;

    h3 {
      margin: 0;
      font-family: var(--font-mono);
      font-size: var(--text-sm);
      color: var(--color-text-strong);
      letter-spacing: 0.03em;
    }
  }

  .statusBadge {
    padding: 4px 8px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    border: 1px solid color-mix(in oklab, var(--color-accent) 45%, transparent);
    border-radius: 999px;
  }

  .statusLinks {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;

    a {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--color-text-strong);

      &:hover,
      &:focus-visible {
        color: var(--color-accent);
      }
    }
  }
</style>
