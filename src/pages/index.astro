---
import About from "@/components/About.astro";
import Contact from "@/components/Contact.astro";
import Hero from "@/components/Hero.astro";
import Writing from "@/components/Writing.astro";
import Base from "@/layouts/Base.astro";
import { sha256CspHash } from "@/lib/csp";
import { PROFILE_EMAIL, PROFILE_NAME, PROFILE_URL } from "@/lib/site";

const description =
  "Tokyo-based AI adoption consultant and software engineer helping teams turn AI plans into reliable products people can use.";

const structuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  dateModified: "2026-07-25",
  mainEntity: {
    "@type": "Person",
    name: PROFILE_NAME,
    givenName: "Yusuke",
    familyName: "Hayashi",
    email: PROFILE_EMAIL,
    url: PROFILE_URL,
    image: `${PROFILE_URL}/me.webp`,
    jobTitle: "AI Adoption Consultant and Software Engineer",
    sameAs: [
      "https://github.com/yhay81",
      "https://twitter.com/yhay81",
      "https://www.linkedin.com/in/yhay81",
      "https://zenn.dev/yhay81",
      "https://keyoxide.org/b22b98abb2d503307ab6a3160718efa6506bb669",
    ],
  },
}).replaceAll("<", "\\u003c");

Astro.csp?.insertScriptHash({
  hash: sha256CspHash(structuredData),
  kind: "element",
});
---

<Base
  description={description}
  path="/"
  title={`${PROFILE_NAME} — AI Adoption & Software Engineering`}
>
  <script is:inline set:html={structuredData} type="application/ld+json" />
  <main>
    <Hero />
    <About />
    <Writing />
    <Contact />
  </main>
</Base>
