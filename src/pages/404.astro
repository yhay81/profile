---
import Base from "@/layouts/Base.astro";
import { PROFILE_NAME } from "@/lib/site";

// Static hosts can serve dist/404.html as the not-found response.
const description = "Page not found.";
---

<Base description={description} path="/404" title={`404 | ${PROFILE_NAME}`}>
  <main>
    <section class="notFound">
      <p class="kicker">$ curl -I …</p>
      <h1 class="title">404</h1>
      <p class="message">
        HTTP/2 404 — this page doesn't exist (or was never signed).
      </p>
      <a class="back" href="/">cd ~</a>
    </section>
  </main>
</Base>

<style>
  .notFound {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
    justify-content: center;
    min-height: calc(100vh - 70px);
  }

  .kicker {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }

  .title {
    font-size: var(--text-display);
    line-height: 1.05;
    text-shadow: 0 10px 30px var(--info-glow);
  }

  .message {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-soft);
  }

  .back {
    padding: 1rem 1.6rem;
    margin-top: 8px;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-bg-deep);
    background-color: var(--color-accent);
    border-radius: var(--radius-sm);
    box-shadow: 0 12px 28px
      color-mix(in oklab, var(--color-accent) 22%, transparent);

    &:hover,
    &:focus-visible {
      color: var(--color-bg-deep);
    }
  }
</style>
