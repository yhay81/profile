---
import { Image } from "astro:assets";

import mePhoto from "@/assets/me.webp";
import SectionHeader from "@/components/SectionHeader.astro";

const EXPERIENCE = [
  {
    period: "2025~",
    periodStartIso: "2025-01-01",
    role: "Founder / AI Adoption Consultant",
    company: "haya Inc.",
    description:
      "Leading AI adoption for teams and founders — planning, piloting, and scaling GenAI solutions that survive contact with production.",
  },
  {
    period: "2025~2026",
    periodStartIso: "2025-01-01",
    role: "Contract Engineer",
    company: "GenerativeX",
    description:
      "Engineering execution for AI-adoption consulting engagements — turning rollout plans into working software.",
  },
  {
    period: "2024~2025",
    periodStartIso: "2024-01-01",
    role: "Contract Engineer",
    company: "LayerX",
    description:
      "Delivered GenAI features with production-safe rollout practices and measurable quality metrics.",
  },
  {
    period: "2021~2022",
    periodStartIso: "2021-01-01",
    role: "Executive Dev Manager",
    company: "QuickWork",
    description:
      "Led feature prioritization, delivery quality, and cloud-native architecture alignment.",
  },
  {
    period: "2018~2021",
    periodStartIso: "2018-01-01",
    role: "Software Engineer",
    company: "Sony / SIE",
    description:
      "Designed and maintained scalable services with a strong emphasis on reliability and user value.",
  },
];

const EDUCATION = [
  "The Open University of Japan (B.A.)",
  "The University of Tokyo (Integrated Science)",
];

const SKILLS = [
  {
    name: "AI",
    items: [
      "LLM integration",
      "RAG pipelines",
      "AI evaluation",
      "Prompt design",
    ],
  },
  {
    name: "Engineering",
    items: [
      "API design",
      "Architecture",
      "Reliability",
      "Cloud infrastructure",
    ],
  },
  {
    name: "Product Delivery",
    items: ["Workflow design", "Team enablement", "Production rollout"],
  },
];
---

<section id="about">
  <SectionHeader label="About" level={2} no="01" title="About Me" />

  <div class="inner">
    <div class="pic">
      <div class="wrapper">
        <Image
          alt="Yusuke Hayashi"
          class="img"
          densities={[1, 2]}
          src={mePhoto}
          width={160}
        />
      </div>
    </div>

    <div class="text">
      <p class="hello">
        I'm a software engineer focused on AI-enabled business applications that
        actually get adopted. Through haya Inc. I run AI-adoption consulting —
        workflow redesign, pilots, rollout, and team enablement — and I keep
        shipping code myself.
      </p>

      <h3>Experiences</h3>

      <ol class="timeline">
        {
          EXPERIENCE.map((item) => (
            <li class="timelineItem reveal">
              <time class="timelinePeriod" datetime={item.periodStartIso}>
                {item.period}
              </time>
              <div class="timelineContent">
                <h4 class="timelineRole">
                  {item.role} <span>@ {item.company}</span>
                </h4>
                <p class="timelineText">{item.description}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <h3>Education</h3>

      <ul class="plainList">
        {EDUCATION.map((item) => <li>{item}</li>)}
      </ul>

      <h3>Skills</h3>

      <div class="skillGrid">
        {
          SKILLS.map((group) => (
            <section class="skillBlock reveal">
              <h4 class="skillTitle">{group.name}</h4>
              <ul class="chipList">
                {group.items.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .inner {
    display: block;

    @media (width >= 901px) {
      display: grid;
      grid-template-columns: minmax(160px, 220px) 1fr;
      gap: 50px;
      align-items: start;
    }
  }

  .text {
    & h3 {
      margin: 24px 0 10px;
      font-size: var(--text-lg);
      color: var(--color-text-strong);
    }

    & p {
      max-width: 60ch;
    }
  }

  .hello {
    margin-bottom: 24px;
    font-size: var(--text-lg);
    color: var(--color-text-soft);
  }

  .plainList {
    display: grid;
    gap: 10px;
    padding: 0;
    margin: 8px 0 0;
    list-style: none;

    & li {
      position: relative;
      padding-left: 18px;
      line-height: 1.6;

      &::before {
        content: "▹";
        position: absolute;
        left: 0;
        color: var(--color-accent);
      }
    }
  }

  .timeline {
    display: grid;
    gap: 14px;
    padding: 0 0 0 20px;
    margin: 14px 0 0;
    list-style: none;
    border-left: 1px solid var(--border-subtle);
  }

  .timelineItem {
    position: relative;
    padding: 12px 0 8px;

    &::before {
      position: absolute;
      top: 2px;
      left: -27px;
      width: 12px;
      height: 12px;
      content: "";
      background: var(--color-accent);
      border: 2px solid var(--color-bg);
      border-radius: 50%;
    }
  }

  .timelinePeriod {
    display: inline-flex;
    margin-bottom: 8px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent);
    letter-spacing: 0.08em;
  }

  .timelineContent {
    display: grid;
    gap: 8px;
  }

  .timelineRole {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text-strong);

    & span {
      font-weight: 400;
      color: var(--color-text-soft);
    }
  }

  .timelineText {
    max-width: 66ch;
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-text);
  }

  .chipList {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: center;
    padding: 0;
    margin: 12px 0 0;
    list-style: none;

    & li {
      display: inline-flex;
      align-items: center;
      min-height: 28px;
      padding: 0 12px;
      font-family: var(--font-mono);
      font-size: var(--text-2xs);
      line-height: 1;
      color: var(--color-text-strong);
      letter-spacing: 0.02em;
      background-color: var(--surface-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      transition:
        color var(--dur-base) var(--ease-swift),
        border-color var(--dur-base) var(--ease-swift);

      &:hover {
        color: var(--color-accent);
        border-color: var(--border-accent);
      }
    }
  }

  .skillGrid {
    display: grid;
    gap: 16px;
    margin-top: 12px;

    @media (width >= 700px) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }
  }

  .skillBlock {
    display: grid;
    gap: 10px;
    max-width: none;
    padding: 18px;
    background: linear-gradient(
      170deg,
      var(--surface-raised),
      color-mix(in oklab, var(--color-bg-deep) 22%, transparent) 65%,
      color-mix(in oklab, var(--color-accent) 4%, transparent)
    );
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
  }

  .skillTitle {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-strong);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .pic {
    max-width: 160px;
    margin: 50px auto;

    @media (width <= 900px) {
      margin: 0 auto 30px;
    }
  }

  .wrapper {
    position: relative;
    width: 160px;
    margin: 0 auto;
    font-size: 0;

    &::after {
      position: absolute;
      top: -3%;
      left: -3%;
      width: 106%;
      height: 106%;
      content: "";
      border: 2px solid var(--info-glow);
      border-radius: 50%;
    }
  }

  .img {
    position: relative;
    height: auto;
    border-radius: 50%;
  }
</style>
