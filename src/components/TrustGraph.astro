---
/**
 * 現在のSigstore release planeと公開identifier adapterを1枚のSVGで示す。
 * 色はサイトのデザイントークン(CSS 変数)を参照する。
 */
---

<figure class="graph">
  <svg
    aria-labelledby="trust-graph-title trust-graph-desc"
    role="img"
    viewBox="0 0 760 500"
    xmlns="http://www.w3.org/2000/svg"
  >
    <title id="trust-graph-title">Trust graph of my identities</title>
    <desc id="trust-graph-desc">
      A pinned GitHub Actions identity produces a Sigstore-attested identity
      release. OpenPGP, public identifier adapters, and Ethereum proofs are
      independently verified against that release.
    </desc>

    <!-- edges -->
    <g class="edges">
      <path class="edge" d="M 190 96 L 328 208"></path>
      <path class="edge" d="M 570 96 L 432 208"></path>
      <path class="edge" d="M 172 250 L 278 250"></path>
      <path class="edge" d="M 588 250 L 482 250"></path>
      <path class="edge twoWay" d="M 380 292 L 380 384"></path>
    </g>

    <!-- edge labels -->
    <g class="edgeLabels">
      <text x="202" y="166">OIDC certificate</text>
      <text x="472" y="166">repo / workflow / ref</text>
      <text x="178" y="238">compatibility</text>
      <text x="486" y="238">signed claims</text>
      <text x="396" y="330">EIP-712 /</text>
      <text x="396" y="348">cross-proof</text>
    </g>

    <!-- nodes -->
    <g class="node">
      <rect height="56" rx="10" width="180" x="100" y="40"></rect>
      <text class="nodeTitle" x="190" y="64">GitHub Actions</text>
      <text class="nodeSub" x="190" y="84">OIDC · hosted runner</text>
    </g>

    <g class="node">
      <rect height="56" rx="10" width="180" x="480" y="40"></rect>
      <text class="nodeTitle" x="570" y="64">Release policy</text>
      <text class="nodeSub" x="570" y="84">exact workflow context</text>
    </g>

    <g class="node">
      <rect height="56" rx="10" width="164" x="8" y="222"></rect>
      <text class="nodeTitle" x="90" y="246">OpenPGP</text>
      <text class="nodeSub" x="90" y="266">compatibility proofs</text>
    </g>

    <g class="node">
      <rect height="56" rx="10" width="164" x="588" y="222"></rect>
      <text class="nodeTitle" x="670" y="246">Public adapters</text>
      <text class="nodeSub" x="670" y="266">DNS · WKD · Nostr</text>
    </g>

    <g class="node keyNode">
      <rect height="84" rx="10" width="204" x="278" y="208"></rect>
      <text class="nodeTitle" x="380" y="240">Sigstore release</text>
      <text class="nodeSub" x="380" y="262">manifest + archive</text>
      <text class="nodeSub" x="380" y="280">SLSA provenance</text>
    </g>

    <g class="node">
      <rect height="56" rx="10" width="240" x="260" y="384"></rect>
      <text class="nodeTitle" x="380" y="408">Ethereum / ENS</text>
      <text class="nodeSub" x="380" y="428">yhay81.eth ⇄ 0x1C04…C079</text>
    </g>
  </svg>
  <figcaption class="caption">
    Release provenance and identifier control are separate checks; every edge
    names the evidence it requires.
  </figcaption>
</figure>

<style>
  .graph {
    max-width: 760px;
    margin: 24px 0 0;
  }

  svg {
    width: 100%;
    height: auto;
  }

  .edge {
    stroke: var(--border-subtle);
    stroke-width: 1.5;
  }

  .edge.twoWay {
    stroke: var(--border-accent);
    stroke-width: 2;
  }

  .edgeLabels text {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--color-text);
  }

  .node rect {
    fill: var(--surface-subtle);
    stroke: var(--border-subtle);
  }

  .keyNode rect {
    fill: var(--accent-glow);
    stroke: var(--border-accent);
  }

  .nodeTitle {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    fill: var(--color-text-strong);
    text-anchor: middle;
  }

  .nodeSub {
    font-family: var(--font-mono);
    font-size: 11px;
    fill: var(--color-text);
    text-anchor: middle;
  }

  .caption {
    margin-top: 10px;
    font-family: var(--font-mono);
    font-size: var(--text-2xs);
    color: var(--color-text-soft);
  }

  /* 狭い画面では縮小せず横スクロールで原寸に近い可読性を保つ */
  @media (width <= 640px) {
    .graph {
      overflow-x: auto;
    }

    svg {
      min-width: 620px;
    }

    .edgeLabels text {
      font-size: 14px;
    }

    .nodeSub {
      font-size: 13px;
    }
  }
</style>
