---
/**
 * コードブロック。CSP の style-src-attr 'none' を維持し、Shiki が生成する
 * inline style を避けるため、意味論的な pre/code だけを静的に出力する。
 */
import { type CodeTokenKind, highlightCode } from "@/lib/code-highlight";

interface Props {
  code: string;
  label?: string;
  language?: string;
  wrap?: boolean;
}

const {
  code,
  label = "Code",
  language = "plain text",
  wrap = false,
} = Astro.props;

const highlightedCode = highlightCode(code, language);
const TOKEN_CLASSES: Readonly<Record<CodeTokenKind, string>> = {
  comment: "tokenComment",
  command: "tokenCommand",
  keyword: "tokenKeyword",
  number: "tokenNumber",
  operator: "tokenOperator",
  option: "tokenOption",
  string: "tokenString",
  url: "tokenUrl",
  variable: "tokenVariable",
};
---

<figure class="codeFrame">
  <figcaption class="codeHeader">
    <span aria-hidden="true" class="codePrompt">❯</span>
    <span>{label}</span>
    <span class="codeLanguage">{language}</span>
  </figcaption>
  <pre
    aria-label={`${label} (${language})`}
    class:list={[
      "codeBlock",
      { wrap },
    ]}><code>{
        highlightedCode.map((token) =>
          token.kind ? (
            <span class={TOKEN_CLASSES[token.kind]}>{token.value}</span>
          ) : (
            token.value
          ),
        )
      }</code></pre>
</figure>

<style is:global>
  .codeFrame {
    margin: 0 0 20px;
    overflow: hidden;
    background: var(--color-code-bg);
    border: 1px solid var(--border-code);
    border-radius: var(--radius-md);
    box-shadow: 0 16px 44px
      color-mix(in oklab, var(--color-bg-deep) 38%, transparent);
  }

  .codeHeader {
    display: flex;
    gap: 9px;
    align-items: center;
    padding: 10px 16px 10px 18px;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-code-label);
    background: var(--color-code-header);
    border-bottom: 1px solid var(--border-code);
  }

  .codePrompt {
    color: var(--color-info);
    font-weight: 700;
  }

  .codeLanguage {
    margin-left: auto;
    color: var(--color-code-muted);
    letter-spacing: 0.04em;
  }

  pre.codeBlock {
    max-width: 100%;
    padding: 20px 22px 22px;
    margin: 0;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: 1.75;
    color: var(--color-code-text);
    tab-size: 2;
    background: transparent;
    border: 0;
    border-radius: 0;

    &.wrap {
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }

    & code {
      font-family: inherit;
    }

    & .tokenComment {
      font-style: italic;
      color: var(--color-code-comment);
    }

    & .tokenCommand {
      font-weight: 650;
      color: var(--color-code-command);
    }

    & .tokenKeyword {
      font-weight: 650;
      color: var(--color-code-keyword);
    }

    & .tokenNumber {
      color: var(--color-code-number);
    }

    & .tokenOperator {
      color: var(--color-code-operator);
    }

    & .tokenOption {
      color: var(--color-code-option);
    }

    & .tokenString {
      color: var(--color-code-string);
    }

    & .tokenUrl {
      color: var(--color-code-url);
      text-decoration: underline;
      text-decoration-color: color-mix(
        in oklab,
        var(--color-code-url) 38%,
        transparent
      );
      text-underline-offset: 0.18em;
    }

    & .tokenVariable {
      color: var(--color-code-variable);
    }
  }

  @media (width <= 640px) {
    .codeHeader {
      padding-inline: 14px;
    }

    pre.codeBlock {
      padding: 17px 16px 19px;
      font-size: var(--text-xs);
      line-height: 1.8;
    }
  }
</style>
