---
/**
 * コードブロック。CSP の style-src-attr 'none' を維持し、Shiki が生成する
 * inline style を避けるため、意味論的な pre/code だけを静的に出力する。
 */
interface Props {
  code: string;
  wrap?: boolean;
}

const { code, wrap = false } = Astro.props;
---

<pre class:list={["codeBlock", { wrap }]}><code>{code}</code></pre>

<style is:global>
  pre.codeBlock {
    margin: 0 0 14px;
    padding: 16px 18px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.8;

    /* テーマの背景ではなくサイトのサーフェスに揃える */
    color: var(--color-text-strong);
    background-color: var(--surface-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);

    &.wrap {
      white-space: pre-wrap;
    }

    & code {
      font-family: inherit;
    }
  }
</style>
