---
import "@/styles/tokens.css";
import "@/styles/global.css";

import Footer from "@/components/Footer.astro";
import Nav from "@/components/Nav.astro";
import Side from "@/components/Side.astro";
import { sha256CspHash } from "@/lib/csp";
import { MAIN_COLOR, PROFILE_URL } from "@/lib/site";

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogType?: "article" | "website";
  author?: string;
  datePublished?: string;
  dateModified?: string;
}

const {
  title,
  description,
  path,
  ogImage = "/og.png",
  ogType = "website",
  author,
  datePublished,
  dateModified,
} = Astro.props;
const canonical = new URL(path, PROFILE_URL).href;
const ogImageAbs = new URL(ogImage, PROFILE_URL).href;

// Prerender internal links on hover. Browsers without Speculation Rules ignore it.
const speculationRules = JSON.stringify({
  prerender: [{ where: { href_matches: "/*" }, eagerness: "moderate" }],
});
const firstVisitScript = `
      if (!sessionStorage.getItem("visited")) {
        document.documentElement.dataset.firstVisit = "";
        sessionStorage.setItem("visited", "1");
      }
    `;

Astro.csp?.insertScriptHash({
  hash: sha256CspHash(firstVisitScript),
  kind: "element",
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <script is:inline>
      if (!sessionStorage.getItem("visited")) {
        document.documentElement.dataset.firstVisit = "";
        sessionStorage.setItem("visited", "1");
      }
    </script>
    <title>{title}</title>
    <meta content={description} name="description" />
    {author && <meta content={author} name="author" />}
    <link href={canonical} rel="canonical" />
    <link
      href="/feed.xml"
      rel="alternate"
      title="Yusuke Hayashi — Writing"
      type="application/rss+xml"
    />
    <meta content={MAIN_COLOR} name="theme-color" />
    <meta content={Astro.generator} name="generator" />

    <link href="/favicon.ico" rel="icon" sizes="32x32" />
    <link href="/favicon.svg" rel="icon" type="image/svg+xml" />
    <link href="/apple-touch-icon.png" rel="apple-touch-icon" />

    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={canonical} property="og:url" />
    <meta content={ogType} property="og:type" />
    <meta content="en_US" property="og:locale" />
    <meta content={ogImageAbs} property="og:image" />
    {
      ogType === "article" && (
        <>
          {author && <meta content={author} property="article:author" />}
          {datePublished && (
            <meta content={datePublished} property="article:published_time" />
          )}
          {dateModified && (
            <meta content={dateModified} property="article:modified_time" />
          )}
        </>
      )
    }
    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content={ogImageAbs} name="twitter:image" />

    <script is:inline set:html={speculationRules} type="speculationrules" />

    <slot name="head" />
  </head>
  <body>
    <Nav currentPath={path} />
    <Side />
    <div id="content">
      <slot />
      <Footer />
    </div>
  </body>
</html>
