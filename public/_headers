/*
  Content-Security-Policy: __GENERATED_CSP__
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Origin-Agent-Cluster: ?1
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=(), clipboard-write=(self)
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML is static but may change on deploy. A short freshness window removes
# repeat-visit network validation without keeping releases stale for long.
/
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/404
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/identity
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/keys
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/proofs
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/siwe
  Cache-Control: public, max-age=300, stale-while-revalidate=86400
/*.html
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# Stable root assets are not fingerprinted, so keep their browser TTL bounded.
/favicon*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/android-chrome-192x192.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/android-chrome-512x512.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/mstile-150x150.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/safari-pinned-tab.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/browserconfig.xml
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/me.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/og-trust-control-plane.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/trust-graph.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
