{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yusuke-hayashi.com/.well-known/schemas/third-party-attestation-index-v1.schema.json",
  "title": "Third-party attestation index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "subject", "updatedAt", "attestations"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schemaVersion": { "const": 1 },
    "subject": { "const": "https://yusuke-hayashi.com" },
    "updatedAt": { "type": "string", "format": "date" },
    "attestations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "url", "sha256", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$" },
          "url": { "type": "string", "format": "uri" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "status": { "enum": ["active", "revoked", "expired"] }
        }
      }
    }
  }
}
