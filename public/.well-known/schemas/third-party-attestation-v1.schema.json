{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yusuke-hayashi.com/.well-known/schemas/third-party-attestation-v1.schema.json",
  "title": "Third-party identity attestation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "subject", "issuer", "claim", "proof", "status"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,127}$" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalUrl", "openpgpFingerprint"],
      "properties": {
        "canonicalUrl": { "const": "https://yusuke-hayashi.com" },
        "openpgpFingerprint": { "const": "B22B98ABB2D503307AB6A3160718EFA6506BB669" },
        "ethereumAddress": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" }
      }
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "identifier"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "identifier": { "type": "string", "minLength": 1 },
        "profileUrl": { "type": "string", "format": "uri" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "statement", "issuedAt"],
      "properties": {
        "type": {
          "enum": ["identity-witness", "professional-relationship", "key-transition-witness", "humanity-witness"]
        },
        "statement": { "type": "string", "minLength": 20, "maxLength": 2000 },
        "observedAt": { "type": "string", "format": "date-time" },
        "verificationMethod": { "enum": ["in-person"] },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "subjectChallenge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nonce", "issuedAt", "expiresAt", "proof"],
      "properties": {
        "nonce": { "type": "string", "pattern": "^0x[a-f0-9]{64}$" },
        "issuedAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "proof": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "address", "message", "signature"],
          "properties": {
            "type": { "const": "eip191" },
            "address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
            "message": { "type": "string", "minLength": 20 },
            "signature": { "type": "string", "pattern": "^0x[a-fA-F0-9]{130}$" }
          }
        }
      }
    },
    "proof": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "signerFingerprint", "publicKeyUrl", "artifactUrl"],
          "properties": {
            "type": { "const": "openpgp-clearsign" },
            "signerFingerprint": { "type": "string", "pattern": "^[A-F0-9]{40}$" },
            "publicKeyUrl": { "type": "string", "format": "uri" },
            "artifactUrl": { "type": "string", "format": "uri" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "address", "message", "signature"],
          "properties": {
            "type": { "const": "eip191" },
            "address": { "type": "string", "pattern": "^0x[a-fA-F0-9]{40}$" },
            "message": { "type": "string", "minLength": 20 },
            "signature": { "type": "string", "pattern": "^0x[a-fA-F0-9]{130}$" }
          }
        }
      ]
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "format": "uri" }
    },
    "status": { "enum": ["active", "revoked", "expired"] },
    "revokedAt": { "type": "string", "format": "date-time" },
    "revocationReason": { "type": "string", "minLength": 1, "maxLength": 500 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "claim": {
            "properties": { "type": { "const": "humanity-witness" } },
            "required": ["type"]
          }
        },
        "required": ["claim"]
      },
      "then": {
        "required": ["subjectChallenge"],
        "properties": {
          "subject": { "required": ["ethereumAddress"] },
          "claim": { "required": ["observedAt", "verificationMethod", "expiresAt"] }
        }
      },
      "else": { "not": { "required": ["subjectChallenge"] } }
    },
    {
      "if": {
        "properties": { "status": { "const": "revoked" } },
        "required": ["status"]
      },
      "then": { "required": ["revokedAt", "revocationReason"] }
    },
    {
      "if": {
        "properties": { "status": { "const": "expired" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "claim": { "required": ["expiresAt"] } }
      }
    }
  ]
}
