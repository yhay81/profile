{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yusuke-hayashi.com/.well-known/schemas/identity-history-v1.schema.json",
  "title": "Yusuke Hayashi identity history v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "subject", "updatedAt", "previousVersionSha256", "events"],
  "properties": {
    "$schema": { "type": "string", "format": "uri" },
    "schemaVersion": { "const": 1 },
    "subject": { "type": "string", "format": "uri" },
    "updatedAt": { "type": "string", "format": "date" },
    "previousVersionSha256": {
      "anyOf": [
        { "type": "null" },
        { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "effectiveAt", "type", "summary", "identifiers", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}/[a-z0-9-]+$" },
          "effectiveAt": { "type": "string", "format": "date" },
          "type": {
            "enum": ["key-rotation", "identifier-created", "proof-published", "identifier-linked"]
          },
          "summary": { "type": "string", "minLength": 1 },
          "identifiers": {
            "type": "object",
            "additionalProperties": { "type": ["string", "null"] }
          },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "format": "uri" }
          }
        }
      }
    }
  }
}
